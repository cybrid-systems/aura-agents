;; Perf section (#14): external-only system observation and an honest
;; capability probe. No target instrumentation: /proc, ss and the
;; perf/bpftrace tools only. When a tool is missing the report says so.

(require "std/string")
(require "std/list")
(require "std/io")
(require "std/process")

(export perf:probe perf:classify perf:blocked-probes perf:require-evidence
        perf:report perf:evidence perf:top-symbols perf:offcpu-plan-with
        perf:flamegraph-plan-with perf:cpu-util perf:mem-used-pct
        perf:net-sum perf:pressure perf:ss-summary perf:disk-sum
        perf:tcp-snmp perf:hypotheses perf:profile-plan perf:help)

(define (perf:help)
  "Perf section: (perf:probe) -> capabilities; (perf:report) -> USE snapshot; (perf:require-evidence mode 'ebpf) fails closed when unsupported")

(define (perf-num s)
  (let ((n (try (string->number s) (catch (e) #f))))
    (if (number? n) n 0)))

(define (perf-tool? name)
  (let ((p (try (command-output (string-append "command -v " name)) (catch (e) #f))))
    (and (string? p) (> (string-length (string-trim p)) 0))))

(define (perf-readable? path)
  (let ((v (try (read-file path) (catch (e) #f))))
    (string? v)))

; Installed is not usable. perf with perf_event_paranoid=3 and bpftrace
; without root both report a clear refusal; capture it instead of calling
; the tool present and advertising an evidence tier it cannot deliver.
(define (perf-command-ok? cmd)
  (let ((code (try (shell (string-append cmd " >/dev/null 2>&1"))
                   (catch (e) 1))))
    (eq? code 0)))

(define (perf-blocked-reason tool paranoid)
  (cond
    ((equal? tool "perf")
     (string-append "perf_event_paranoid=" (number->string paranoid)
                    " (CAP_PERFMON/CAP_SYS_ADMIN required)"))
    ((equal? tool "bpftrace") "root-required")
    (else "command-failed")))

(define (perf-paranoid)
  (let ((v (try (read-file "/proc/sys/kernel/perf_event_paranoid") (catch (e) #f))))
    (if (string? v) (perf-num (string-trim v)) -1)))

; tools is a hash of booleans plus "paranoid". The result names the
; strongest evidence tier this host can honestly provide.
(define (perf:classify tools)
  (let* ((perf (hash-ref tools "perf" #f))
         (bpf (hash-ref tools "bpftrace" #f))
         (proc (hash-ref tools "proc" #f))
         (paranoid (hash-ref tools "paranoid" -1)))
    (cond
      ((and perf bpf proc (<= paranoid 1)) "full-ebpf")
      ((and perf proc (<= paranoid 2)) "perf-only")
      (proc "proc-stat-only")
      (else "minimal"))))

(define (perf:blocked-probes installed usable paranoid)
  (let loop ((ks (list "perf" "bpftrace" "ss")))
    (cond
      ((not (pair? ks)) '())
      ((and (hash-ref installed (car ks) #f)
            (not (hash-ref usable (car ks) #f)))
       (cons (hash "tool" (car ks)
                   "reason" (perf-blocked-reason (car ks) paranoid))
             (loop (cdr ks))))
      (else (loop (cdr ks))))))

(define (perf:probe)
  (let* ((perf-installed (perf-tool? "perf"))
         (bpf-installed (perf-tool? "bpftrace"))
         (ss-installed (perf-tool? "ss"))
         (proc (perf-readable? "/proc/stat"))
         (paranoid (perf-paranoid))
         (perf-ok (and perf-installed
                       (perf-command-ok? "perf stat -e task-clock true")))
         (bpf-ok (and bpf-installed
                      (perf-command-ok? "bpftrace -e 'BEGIN { exit(); }'")))
         (ss-ok (and ss-installed (perf-command-ok? "ss -s")))
         (installed (hash "perf" perf-installed "bpftrace" bpf-installed
                          "ss" ss-installed "proc" proc))
         (usable (hash "perf" perf-ok "bpftrace" bpf-ok
                       "ss" ss-ok "proc" proc))
         (mode (perf:classify (hash "perf" perf-ok "bpftrace" bpf-ok
                                    "proc" proc "paranoid" paranoid)))
         (missing (filter (lambda (x) (not (cadr x)))
                          (list (list "perf" perf-installed)
                                (list "bpftrace" bpf-installed)
                                (list "ss" ss-installed)
                                (list "proc" proc)))))
    (hash "mode" mode
          "degraded" (not (equal? mode "full-ebpf"))
          "missing" (map car missing)
          "blocked" (perf:blocked-probes installed usable paranoid)
          "installed" installed
          "usable" usable
          "perf_event_paranoid" paranoid
          "tools" usable)))

; Evidence tiers are ordered. A contract that demands a stronger tier
; than the host offers is refused, never silently skipped.
(define (perf-tier-rank tier)
  (cond ((equal? tier "minimal") 0)
        ((equal? tier "proc") 1)
        ((equal? tier "proc-stat-only") 1)
        ((equal? tier "perf") 2)
        ((equal? tier "perf-only") 2)
        ((equal? tier "ebpf") 3)
        ((equal? tier "full-ebpf") 3)
        (else -1)))

(define (perf:require-evidence mode needed)
  (let ((m (perf-tier-rank mode))
        (n (perf-tier-rank needed)))
    (if (or (< m 0) (< n 0) (< m n))
      (hash "ok" #f "error" "capability-missing" "mode" mode "needed" needed)
      (hash "ok" #t "mode" mode "needed" needed))))

; ── parsers (pure; fixtures use the same functions) ────────────

(define (perf-first-line text)
  (let ((rows (string-split text "\n")))
    (if (pair? rows) (car rows) "")))

(define (perf-cpu-row text)
  (let ((words (string-split-words (perf-first-line text))))
    (if (and (pair? words) (equal? (car words) "cpu"))
      (map perf-num (cdr words))
      '())))

; (cpu-util stat0 stat1) -> percent busy in [0,100], or #f.
(define (perf:cpu-util stat0 stat1)
  (let* ((a (perf-cpu-row stat0))
         (b (perf-cpu-row stat1)))
    (if (or (< (length a) 4) (< (length b) 4))
      #f
      (let* ((sum-a (apply + (take a 8)))
             (sum-b (apply + (take b 8)))
             (idle-a (+ (list-ref a 3) (if (>= (length a) 5) (list-ref a 4) 0)))
             (idle-b (+ (list-ref b 3) (if (>= (length b) 5) (list-ref b 4) 0)))
             (dt (- sum-b sum-a))
             (di (- idle-b idle-a)))
        (if (<= dt 0) #f
            (/ (* 100.0 (- dt di)) dt))))))

(define (perf-kb text key)
  (let loop ((lines (string-split text "\n")))
    (cond ((not (pair? lines)) #f)
          ((string-prefix? (string-trim (car lines)) key)
           (let ((words (string-split-words (car lines))))
             (if (and (pair? words) (pair? (cdr words)))
               (perf-num (cadr words))
               #f)))
          (else (loop (cdr lines))))))

(define (perf:mem-used-pct meminfo)
  (let ((total (perf-kb meminfo "MemTotal:"))
        (avail (perf-kb meminfo "MemAvailable:")))
    (if (and total avail (> total 0))
      (/ (* 100.0 (- total avail)) total)
      #f)))

; Sum rx/tx bytes and errors/drops over non-loopback interfaces.
(define (perf:net-sum netdev)
  (let loop ((lines (string-split netdev "\n"))
             (rx 0) (tx 0) (rx-err 0) (tx-err 0) (rx-drop 0) (tx-drop 0))
    (cond
      ((not (pair? lines))
       (hash "rx_bytes" rx "tx_bytes" tx
             "rx_errors" rx-err "tx_errors" tx-err
             "rx_dropped" rx-drop "tx_dropped" tx-drop))
      ((not (string-contains? (car lines) ":"))
       (loop (cdr lines) rx tx rx-err tx-err rx-drop tx-drop))
      (else
       (let* ((parts (string-split (car lines) ":"))
              (iface (if (pair? parts) (string-trim (car parts)) ""))
              (nums (if (pair? (cdr parts)) (string-split-words (cadr parts)) '())))
         (if (or (equal? iface "lo") (< (length nums) 12))
           (loop (cdr lines) rx tx rx-err tx-err rx-drop tx-drop)
           (loop (cdr lines)
                 (+ rx (perf-num (list-ref nums 0)))
                 (+ tx (perf-num (list-ref nums 8)))
                 (+ rx-err (perf-num (list-ref nums 2)))
                 (+ tx-err (perf-num (list-ref nums 10)))
                 (+ rx-drop (perf-num (list-ref nums 3)))
                 (+ tx-drop (perf-num (list-ref nums 11))))))))))

; (perf:ss-summary "ss -s" text) -> socket counts without needing root.
(define (perf:ss-summary text)
  (let ((lines (string-split text "\n")))
    (let loop ((xs lines) (out (hash "total" 0 "tcp" 0 "estab" 0
                                     "closed" 0 "orphaned" 0 "timewait" 0)))
      (cond
        ((not (pair? xs)) out)
        ((string-prefix? (string-trim (car xs)) "Total:")
         (let ((words (string-split-words (car xs))))
           (if (and (pair? (cdr words)) (number? (string->number (cadr words))))
             (hash-set! out "total" (string->number (cadr words)))
             #f)
           (loop (cdr xs) out)))
        ((string-prefix? (string-trim (car xs)) "TCP:")
         (let* ((clean (string-replace
                         (string-replace
                           (string-replace (car xs) "(" " ")
                           ")" " ")
                         "," " "))
                (words (string-split-words clean)))
           (if (and (pair? (cdr words)) (number? (string->number (cadr words))))
             (hash-set! out "tcp" (string->number (cadr words)))
             #f)
           (let scan ((ws words))
             (cond
               ((not (pair? ws)) #f)
               ((and (pair? (cdr ws))
                     (member? (car ws) (list "estab" "closed" "orphaned" "timewait"))
                     (number? (string->number (cadr ws))))
                (hash-set! out (car ws) (string->number (cadr ws)))
                (scan (cddr ws)))
               (else (scan (cdr ws)))))
           (loop (cdr xs) out)))
        (else (loop (cdr xs) out))))))

; (perf:disk-sum /proc/diskstats text) -> sector/IO totals for real
; block devices (loop, ram and device-mapper pseudo entries are skipped).
(define (perf-disk? name)
  (not (or (string-prefix? name "loop") (string-prefix? name "ram")
           (string-prefix? name "zram") (string-prefix? name "dm-")
           (string-prefix? name "sr"))))

(define (perf:disk-sum text)
  (let loop ((lines (string-split text "\n"))
             (reads 0) (writes 0) (sectors-r 0) (sectors-w 0)
             (io-ms 0) (weighted-ms 0))
    (cond
      ((not (pair? lines))
       (hash "reads" reads "writes" writes
             "sectors_read" sectors-r "sectors_written" sectors-w
             "io_ms" io-ms "weighted_io_ms" weighted-ms))
      (else
       (let ((ws (string-split-words (car lines))))
         (if (or (< (length ws) 14) (not (perf-disk? (caddr ws))))
           (loop (cdr lines) reads writes sectors-r sectors-w io-ms weighted-ms)
           (loop (cdr lines)
                 (+ reads (perf-num (list-ref ws 3)))
                 (+ writes (perf-num (list-ref ws 7)))
                 (+ sectors-r (perf-num (list-ref ws 5)))
                 (+ sectors-w (perf-num (list-ref ws 9)))
                 (+ io-ms (perf-num (list-ref ws 12)))
                 (+ weighted-ms (perf-num (list-ref ws 13))))))))))

; (perf:tcp-snmp /proc/net/snmp text) -> RetransSegs / InErrs / OutRsts.
(define (perf:tcp-snmp text)
  (let ((lines (string-split text "\n")))
    (let loop ((xs lines) (header '()) (out (hash "retrans" 0 "in_errors" 0
                                                   "out_rsts" 0)))
      (cond
        ((not (pair? xs)) out)
        ((string-prefix? (string-trim (car xs)) "Tcp:")
         (let ((ws (string-split-words (car xs))))
           (if (null? header)
             (loop (cdr xs) ws out)
             (let ((vals (map perf-num (cdr ws))))
               (let index-of ((names (cdr header)) (i 0))
                 (cond
                   ((not (pair? names)) #f)
                   ((equal? (car names) "RetransSegs")
                    (hash-set! out "retrans" (list-ref vals i))
                    (index-of (cdr names) (+ i 1)))
                   ((equal? (car names) "InErrs")
                    (hash-set! out "in_errors" (list-ref vals i))
                    (index-of (cdr names) (+ i 1)))
                   ((equal? (car names) "OutRsts")
                    (hash-set! out "out_rsts" (list-ref vals i))
                    (index-of (cdr names) (+ i 1)))
                   (else (index-of (cdr names) (+ i 1)))))
               (loop (cdr xs) header out))))
         )
        (else (loop (cdr xs) header out))))))

(define (perf:pressure text)
  (let ((words (string-split-words (perf-first-line text))))
    (let loop ((xs words) (out (hash)))
      (cond
        ((not (pair? xs)) out)
        ((string-prefix? (car xs) "avg10=")
         (hash-set! out "avg10" (perf-num (string-drop (car xs) 6)))
         (loop (cdr xs) out))
        (else (loop (cdr xs) out))))))

; ── report ─────────────────────────────────────────────────────

(define (perf-read path)
  (let ((v (try (read-file path) (catch (e) #f))))
    (if (string? v) v "")))

(define (perf-read-command cmd)
  (let ((v (try (command-output cmd) (catch (e) ""))))
    (if (string? v) v "")))

(define (perf-delta before after keys)
  (let loop ((ks keys) (out (hash)))
    (cond
      ((not (pair? ks)) out)
      (else
       (let ((a (hash-ref before (car ks) 0))
             (b (hash-ref after (car ks) 0)))
         (hash-set! out (car ks)
                    (max 0 (- (if (number? b) b 0)
                              (if (number? a) a 0))))
         (loop (cdr ks) out))))))

(define (perf-wait-ms ms)
  (let ((start (monotonic-ms)))
    (let loop ()
      (if (>= (- (monotonic-ms) start) ms)
        #t
        (begin (try (fiber:yield) (catch (e) #f)) (loop))))))

; Heuristics only; each names the evidence it read and never claims a
; cause. A blocked tool is itself a finding, not a silent skip.
(define (perf:hypotheses r)
  (let* ((caps (hash-ref r "capabilities" (hash)))
         (blocked (hash-ref caps "blocked" '()))
         (cpu (hash-ref r "cpu_util_pct" #f))
         (mem (hash-ref r "mem_used_pct" #f))
         (press (hash-ref (hash-ref r "cpu_pressure" (hash)) "avg10" 0))
         (net (hash-ref r "net" (hash)))
         (tcp (hash-ref r "tcp" (hash)))
         (ss (hash-ref r "ss" (hash)))
         (hints (list)))
    (if (pair? blocked)
      (set! hints
            (cons (hash "signal" "perf-blocked"
                        "suggestion" "run with CAP_PERFMON or set perf_event_paranoid<=1; on/off-CPU flamegraphs are unavailable"
                        "evidence" blocked)
                  hints))
      #f)
    (if (and (number? cpu) (> cpu 80.0))
      (set! hints
            (cons (hash "signal" "cpu-util"
                        "suggestion" "CPU-bound; inspect on-CPU symbols and per-fiber runqueue"
                        "evidence" cpu)
                  hints))
      #f)
    (if (> press 20.0)
      (set! hints
            (cons (hash "signal" "cpu-pressure"
                        "suggestion" "runqueue contention; inspect off-CPU and channel waits"
                        "evidence" press)
                  hints))
      #f)
    (if (and (number? mem) (> mem 85.0))
      (set! hints
            (cons (hash "signal" "memory-used"
                        "suggestion" "memory pressure; inspect heap growth and GC pauses"
                        "evidence" mem)
                  hints))
      #f)
    (if (or (> (hash-ref tcp "retrans" 0) 0)
            (> (hash-ref net "rx_errors" 0) 0)
            (> (hash-ref net "tx_errors" 0) 0))
      (set! hints
            (cons (hash "signal" "network-errors"
                        "suggestion" "network errors or retransmits; inspect ss and TCP counters"
                        "evidence" (hash "retrans" (hash-ref tcp "retrans" 0)
                                         "rx_errors" (hash-ref net "rx_errors" 0)
                                         "tx_errors" (hash-ref net "tx_errors" 0)))
                  hints))
      #f)
    (if (> (hash-ref ss "timewait" 0) 100)
      (set! hints
            (cons (hash "signal" "timewait"
                        "suggestion" "connection churn; inspect TIME_WAIT and connection reuse"
                        "evidence" (hash-ref ss "timewait" 0))
                  hints))
      #f)
    (if (null? hints)
      (list (hash "signal" "none"
                  "suggestion" "no USE threshold crossed in this window"
                  "evidence" (hash "cpu_util_pct" cpu "mem_used_pct" mem
                                   "cpu_pressure_avg10" press)))
      (reverse hints))))

(define (perf:report . rest)
  (let* ((opts (if (and (pair? rest) (hash? (car rest))) (car rest) (hash)))
         (window (let ((n (hash-ref opts "window_ms" 100)))
                   (if (number? n) n 100)))
         (probe (perf:probe))
         (stat0 (perf-read "/proc/stat"))
         (net0 (perf:net-sum (perf-read "/proc/net/dev")))
         (disk0 (perf:disk-sum (perf-read "/proc/diskstats")))
         (tcp0 (perf:tcp-snmp (perf-read "/proc/net/snmp")))
         (_ (if (> window 0) (perf-wait-ms window) #f))
         (stat1 (perf-read "/proc/stat"))
         (mem (perf-read "/proc/meminfo"))
         (net1 (perf:net-sum (perf-read "/proc/net/dev")))
         (pressure (perf-read "/proc/pressure/cpu"))
         (disk1 (perf:disk-sum (perf-read "/proc/diskstats")))
         (tcp1 (perf:tcp-snmp (perf-read "/proc/net/snmp")))
         (net (perf-delta net0 net1
                          (list "rx_bytes" "tx_bytes" "rx_errors" "tx_errors"
                                "rx_dropped" "tx_dropped")))
         (disk (perf-delta disk0 disk1
                           (list "reads" "writes" "sectors_read" "sectors_written"
                                 "io_ms" "weighted_io_ms")))
         (tcp (perf-delta tcp0 tcp1
                          (list "retrans" "in_errors" "out_rsts")))
         (ss (if (hash-ref (hash-ref probe "usable" (hash)) "ss" #f)
               (perf:ss-summary (perf-read-command "ss -s"))
               (hash "total" 0 "tcp" 0 "estab" 0 "closed" 0
                     "orphaned" 0 "timewait" 0)))
         (r (hash "mode" (hash-ref probe "mode")
                  "degraded" (hash-ref probe "degraded")
                  "missing" (hash-ref probe "missing" '())
                  "blocked" (hash-ref probe "blocked" '())
                  "capabilities" probe
                  "cpu_util_pct" (perf:cpu-util stat0 stat1)
                  "mem_used_pct" (perf:mem-used-pct mem)
                  "net" (perf:net-sum net)
                  "disk" disk
                  "tcp" tcp
                  "ss" ss
                  "window_ms" window
                  "cpu_pressure" (perf:pressure pressure)
                  "source" "external-only:/proc,/ss")))
    (hash-set! r "hypotheses" (perf:hypotheses r))
    r))

; Evidence-only peer payload: capabilities are read+publish; no keep or
; rollback path exists in this section.
(define (perf:evidence)
  (let ((r (perf:report)))
    (hash "kind" "perf-evidence"
          "mode" (hash-ref r "mode")
          "degraded" (hash-ref r "degraded")
          "missing_probes" (hash-ref r "missing" '())
          "blocked_probes" (hash-ref r "blocked" '())
          "hypotheses" (hash-ref r "hypotheses" '())
          "report" r
          "caps" '("read" "publish"))))

; Parse the default 'perf report --stdio --no-children' table. The
; symbol may contain spaces; the first three words are overhead, command
; and DSO, the rest is the symbol.
(define (perf:top-symbols report . rest)
  (let ((limit (if (and (pair? rest) (number? (car rest))) (car rest) 5)))
    (let loop ((lines (string-split report "\n")) (acc '()))
      (cond
        ((not (pair? lines)) (reverse acc))
        ((>= (length acc) limit) (reverse acc))
        (else
         (let* ((line (string-trim (car lines)))
                (words (string-split-words line)))
           (cond
             ((or (not (pair? words))
                  (string-prefix? line "#")
                  (not (string-suffix? (car words) "%")))
              (loop (cdr lines) acc))
             ((< (length words) 4) (loop (cdr lines) acc))
             (else
              (let ((overhead (perf-num (substring (car words) 0 (- (string-length (car words)) 1))))
                    (cmd (cadr words))
                    (dso (caddr words))
                    (symbol (string-join (cdddr words) " ")))
                (loop (cdr lines)
                      (cons (hash "overhead_pct" overhead
                                  "command" cmd
                                  "dso" dso
                                  "symbol" symbol)
                            acc)))))))))))

(define (perf:offcpu-plan-with tools pid seconds)
  (cond
    ((not (and (number? pid) (number? seconds)))
     (hash "ok" #f "error" "bad-arguments"))
    ((hash-ref tools "bpftrace" #f)
     (hash "ok" #t "mode" "offcpu"
           "command" (string-append "offcputime-bpfcc -p " (number->string pid)
                                    " " (number->string seconds))
           "evidence" "off-cpu-stacks"))
    ((hash-ref tools "perf" #f)
     (hash "ok" #t "mode" "sched"
           "command" (string-append "perf sched record -p " (number->string pid)
                                    " -- sleep " (number->string seconds))
           "evidence" "sched-latency"))
    (else (hash "ok" #f "error" "offcpu-unavailable"))))

(define (perf:flamegraph-plan-with tools)
  (if (hash-ref tools "perf" #f)
    (hash "ok" #t
          "on_cpu" "perf script -i out/perf.data > out/oncpu.script && python3 scripts/perf_flamegraph.py --script out/oncpu.script --folded out/oncpu.folded --svg out/oncpu.svg"
          "off_cpu" "stack-level off-CPU needs tracefs/BPF; use scripts/proc_schedstat.py for runqueue wait and context switches"
          "off_cpu_floor" "python3 scripts/proc_schedstat.py --pid PID --seconds N")
    (hash "ok" #f "error" "perf-missing")))

(define (perf:profile-plan pid seconds)
  (let ((probe (perf:probe)))
    (cond
      ((not (hash-ref (hash-ref probe "tools") "perf" #f))
       (if (hash-ref (hash-ref probe "installed" (hash)) "perf" #f)
         (hash "ok" #f "error" "perf-blocked" "mode" (hash-ref probe "mode")
               "blocked" (hash-ref probe "blocked" '()))
         (hash "ok" #f "error" "perf-missing" "mode" (hash-ref probe "mode"))))
      ((not (number? pid)) (hash "ok" #f "error" "bad-pid"))
      ((not (number? seconds)) (hash "ok" #f "error" "bad-seconds"))
      (else
       (hash "ok" #t
             "mode" (hash-ref probe "mode")
             "record" (string-append "perf record -F 99 -g -p " (number->string pid)
                                     " -o out/perf.data -- sleep " (number->string seconds))
             "report" "perf report -i out/perf.data --stdio --no-children")))))
