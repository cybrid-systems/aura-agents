;; Deterministic mock LLM. No network, no key, no clock.
;; Planner replies follow the requirement. Worker replies carry a
;; MUTATE block the judge applies; RESULT is only a self-report.
(require "std/string")
(require "lib/roles/contract")
(require "lib/trial/workspace")

(define *mock-calls* 0)

(define (mock:reset!)
  (set! *mock-calls* 0))

(define (mock:calls) *mock-calls*)

(define (mock:complete role user)
  (set! *mock-calls* (+ *mock-calls* 1))
  (cond
    ((equal? role "planner") (contract:reply user))
    ((equal? role "worker") (trial:worker-reply user))
    (else "RESULT tests=pass\n")))
