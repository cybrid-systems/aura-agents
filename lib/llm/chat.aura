;; LLM seam. Tests and CI stay on the mock.
;; Real calls go through std/llm llm:chat.
;; LLM_API_KEY, LLM_BASE_URL and LLM_MODEL are read by llm:chat from
;; the environment (llm:chat's own base URL already defaults to
;; https://api.deepseek.com/v1). llm:chat's model default is
;; deepseek-chat; when LLM_MODEL is unset this module asks for
;; deepseek-flash, the DeepSeek V4.1 Flash preset used by aura-runner.
;; AURA_AGENTS_LLM=mock forces the mock even if a key is present.
;; AURA_AGENTS_LLM=real forces llm:chat. Unset uses real only when a
;; key is present, otherwise the mock. A real run needs
;; `aura run --grant network`; without that grant the call fails closed
;; and the planner surfaces the llm error.
(require "std/llm")
(require "lib/llm/mock")

(define (chat:key?)
  (let ((k (getenv "LLM_API_KEY")))
    (and (string? k) (> (string-length k) 0))))

(define (chat:mode-of flag key?)
  (cond
    ((equal? flag "mock") "mock")
    ((equal? flag "real") "real")
    (key? "real")
    (else "mock")))

(define (chat:mode)
  (chat:mode-of (getenv "AURA_AGENTS_LLM") (chat:key?)))

(define (chat:model-of env)
  (if (and (string? env) (> (string-length env) 0))
    env
    "deepseek-flash"))

(define (chat:model)
  (chat:model-of (getenv "LLM_MODEL")))

;; Role timeout in seconds. An explicit role value wins, then the
;; shared AURA_AGENTS_LLM_TIMEOUT, then 180 for a worker and 150 for
;; the planner. llm:chat treats "timeout" as the transport budget.
(define (chat:pick-timeout role role-n global-n)
  (cond
    ((and (number? role-n) (> role-n 0)) role-n)
    ((and (number? global-n) (> global-n 0)) global-n)
    ((equal? role "worker") 180)
    ((equal? role "planner") 150)
    (else 60)))

(define (chat:env-seconds name)
  (let ((v (getenv name)))
    (if (and (string? v) (> (string-length v) 0))
      (let ((n (string->number v)))
        (if (and (number? n) (> n 0)) n #f))
      #f)))

(define (chat:timeout-of role)
  (chat:pick-timeout role
                     (chat:env-seconds (if (equal? role "worker")
                                         "AURA_AGENTS_WORKER_TIMEOUT"
                                         "AURA_AGENTS_PLANNER_TIMEOUT"))
                     (chat:env-seconds "AURA_AGENTS_LLM_TIMEOUT")))

(define (chat:err e)
  (cond
    ((string? e) e)
    ((and (pair? e) (pair? (cdr e)) (string? (cadr e))) (cadr e))
    (else "llm-exception")))

(define (chat:real role system user)
  (try
    (let* ((model (chat:model))
           (from-env (getenv "LLM_MODEL"))
           (extra (if (and (string? from-env) (> (string-length from-env) 0))
                    (hash "temperature" 0 "timeout" (chat:timeout-of role))
                    (hash "model" model "temperature" 0 "timeout" (chat:timeout-of role))))
           (r (llm:chat (if (string? system) system "")
                        (if (string? user) user "")
                        extra)))
      (cond
        ((and (hash? r) (hash-ref r "ok" #f))
         (let ((content (hash-ref r "content" "")))
           (if (string? content) content "")))
        ((hash? r) (string-append "ERROR " (hash-ref r "error" "llm")))
        (else "ERROR llm")))
    (catch (e) (string-append "ERROR " (chat:err e)))))

(define (chat:complete mode role system user)
  (if (equal? mode "real")
    (chat:real role system user)
    (mock:complete role user)))
