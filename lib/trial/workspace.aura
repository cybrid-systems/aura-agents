;; Isolated trial workspace. The seed under fixtures/trials is never
;; written. Each attempt gets its own directory under out/trials (the
;; overlay). The worker's MUTATE form or unified PATCH is applied only
;; there. The judge then runs aura test, and a bench when the contract
;; asks for p99 or a budget. The worker RESULT line is not consulted.
(require "std/string")
(require "std/fs")
(require "std/process")
(require "lib/text")
(require "lib/roles/contract")
(require "lib/llm/stdlib-ref")

(define trial:files
  (hash "redis" '("aura.toml" "src/zset.aura" "src/latency.aura"
                  "tests/zset_test.aura" "tests/zset_test.golden" "bench.aura")
        "wordcount" '("aura.toml" "src/wc.aura"
                      "tests/wc_test.aura" "tests/wc_test.golden")
        "perf" '("aura.toml" "src/hot.aura"
                 "tests/hot_test.aura" "tests/hot_test.golden" "bench.aura")
        "generic" '("aura.toml" "src/marker.aura"
                    "tests/marker_test.aura" "tests/marker_test.golden")))

;; Cap on the fixture text copied into the planner/worker CONTEXT.
(define trial:context-limit 4096)

;; Default CONTEXT: the target fixture's own files, not the word "none".
;; Truncated so a larger tree cannot blow the prompt.
(define (trial:files-text kind limit)
  (let ((files (hash-ref trial:files (if (string? kind) kind "") '())))
    (let loop ((xs files) (out ""))
      (cond
        ((not (pair? xs)) out)
        ((>= (string-length out) limit)
         (string-append (substring out 0 limit) "\n...truncated\n"))
        (else
          (let* ((rel (car xs))
                 (text (file-read (string-append "fixtures/trials/" kind "/" rel)))
                 (body (if (string? text) text ""))
                 (chunk (string-append "FILE " rel "\n" body "\n"))
                 (next (string-append out chunk)))
            (if (> (string-length next) limit)
              (string-append (substring next 0 limit) "\n...truncated\n")
              (loop (cdr xs) next))))))))

;; Fixture sources first, then a capped stdlib export list.
(define (trial:fixture-context kind)
  (let* ((files (trial:files-text kind 2600))
         (lib (stdlib:brief 1400))
         (all (string-append files "\n" lib)))
    (if (> (string-length all) trial:context-limit)
      (string-append (substring all 0 trial:context-limit) "\n...truncated\n")
      all)))

(define *trial-root* #f)

(define (trial:set-root! path)
  (set! *trial-root* path))

;; AURA_AGENTS_TARGET is a local Aura project. Reads copy it into
;; out/trials; the source directory is never written.
(define (trial:root)
  (if (and (string? *trial-root*) (> (string-length *trial-root*) 0))
    *trial-root*
    (let ((env (getenv "AURA_AGENTS_TARGET")))
      (if (and (string? env) (> (string-length (string-trim env)) 0))
        (string-trim env)
        #f))))

(define (trial:safe-dest? dest)
  (and (string? dest) (string-prefix? dest "out/trials/")))

(define (trial:copy-tree src dest)
  (if (or (not (trial:safe-dest? dest))
          (not (string? src))
          (string=? src "")
          (string-contains? src ".."))
    #f
    (begin
      (trial:reset-dir! dest)
      (make-directory dest)
      (= (trial:shell (string-append "cp -a "
                                     (trial:quote (string-append src "/."))
                                     " "
                                     (trial:quote dest)))
         0))))

(define (trial:context-budget-of raw)
  (let ((n (if (and (string? raw) (> (string-length raw) 0)) (string->number raw) #f)))
    (if (and (number? n) (> n 0))
      (if (integer? n) n (inexact->exact (floor n)))
      16384)))

(define (trial:context-budget)
  (trial:context-budget-of (getenv "AURA_AGENTS_CONTEXT_BUDGET")))

(define (trial:context-seeds requirement)
  (let ((s (contract:scoped (if (string? requirement) requirement ""))))
    (let loop ((xs (string-split-words s)) (acc '()))
      (if (not (pair? xs))
        acc
        (loop (cdr xs)
              (if (>= (string-length (car xs)) 3)
                (cons (car xs) acc)
                acc))))))

(define (trial:rel-path root abs)
  (let ((prefix (string-append root "/")))
    (if (and (string? abs) (string-prefix? abs prefix))
      (substring abs (string-length prefix) (string-length abs))
      (if (string? abs) abs ""))))

(define (trial:hit? rel body seeds)
  (let loop ((xs seeds))
    (cond
      ((not (pair? xs)) #f)
      ((and (string? (car xs)) (> (string-length (car xs)) 0)
            (or (string-contains? rel (car xs))
                (and (string? body) (string-contains? body (car xs)))))
       #t)
      (else (loop (cdr xs))))))

(define (trial:aura-files root)
  (let ((out (try (command-output
                    (string-append "find " (trial:quote root)
                                   " -type f -name '*.aura'"))
                  (catch (e) ""))))
    (let loop ((xs (text:lines (if (string? out) out ""))) (acc '()))
      (if (not (pair? xs))
        (reverse acc)
        (let ((p (string-trim (car xs))))
          (loop (cdr xs) (if (string=? p "") acc (cons p acc))))))))

(define (trial:take-chunk out left chunk)
  (if (> (string-length chunk) left)
    (list out left)
    (list (string-append out chunk) (- left (string-length chunk)))))

;; Top-level forms, each kept whole. A cut never stops inside one.
(define (trial:top-forms text)
  (let ((n (string-length (if (string? text) text ""))))
    (let loop ((i 0) (depth 0) (start #f) (acc '()))
      (if (>= i n)
        (reverse acc)
        (let ((c (string-ref text i)))
          (cond
            ((and (= depth 0) (not (= c 40)))
             (loop (+ i 1) 0 #f acc))
            ((= c 40)
             (loop (+ i 1) (+ depth 1) (if start start i) acc))
            ((= c 41)
             (if (and (= depth 1) start)
               (loop (+ i 1) 0 #f (cons (substring text start (+ i 1)) acc))
               (loop (+ i 1) (if (> depth 0) (- depth 1) 0) start acc)))
            (else (loop (+ i 1) depth start acc))))))))

(define (trial:pack-forms forms left)
  (let loop ((xs forms) (out "") (used 0))
    (if (not (pair? xs))
      out
      (let ((piece (string-append (if (string=? out "") "" "\n") (car xs))))
        (if (> (+ used (string-length piece)) left)
          out
          (loop (cdr xs) (string-append out piece) (+ used (string-length piece))))))))

(define (trial:matching-forms text seeds)
  (let loop ((xs (trial:top-forms text)) (acc '()))
    (if (not (pair? xs))
      (reverse acc)
      (loop (cdr xs)
            (if (trial:hit? "" (car xs) seeds) (cons (car xs) acc) acc)))))

;; A hit file is included whole. If it does not fit, include complete
;; matching forms instead of cutting mid-function. Other files wait.
(define (trial:pack-hit rel text seeds left)
  (let* ((header (string-append "FILE " rel "\n"))
         (full (string-append header text "\n"))
         (room (max 0 (- left (string-length header)))))
    (if (<= (string-length full) left)
      (list full (string-length full))
      (let* ((matched (trial:matching-forms text seeds))
             (forms (if (pair? matched) matched (trial:top-forms text)))
             (body (trial:pack-forms forms room)))
        (if (string=? body "")
          (list "" 0)
          (let ((chunk (string-append header body "\n")))
            (if (> (string-length chunk) left)
              (list "" 0)
              (list chunk (string-length chunk)))))))))

;; Full text of files whose path or body matches a requirement or task
;; token, then a relative-path list with whatever budget remains.
;; Non-matching text is dropped before a matching form is cut.
(define (trial:external-context-budget root requirement budget)
  (let ((seeds (trial:context-seeds requirement))
        (abs (trial:aura-files root))
        (limit (if (and (number? budget) (> budget 0)) budget 16384)))
    (let ((packed (let loop ((xs abs) (hits '()) (rest '()))
                    (if (not (pair? xs))
                      (list (reverse hits) (reverse rest))
                      (let* ((rel (trial:rel-path root (car xs)))
                             (body (file-read (car xs)))
                             (text (if (string? body) body "")))
                        (if (trial:hit? rel text seeds)
                          (loop (cdr xs) (cons (list rel text) hits) rest)
                          (loop (cdr xs) hits (cons rel rest))))))))
      (let ((full (let loop ((xs (car packed)) (out "") (left limit))
                    (if (or (not (pair? xs)) (<= left 0))
                      (list out left)
                      (let ((step (trial:pack-hit (car (car xs)) (cadr (car xs)) seeds left)))
                        (loop (cdr xs)
                              (string-append out (car step))
                              (- left (cadr step))))))))
        (let loop ((xs (cadr packed)) (out (car full)) (left (cadr full)) (head #t))
          (if (or (not (pair? xs)) (<= left 0))
            out
            (let ((step (trial:take-chunk
                          out left
                          (string-append (if head "FILES\n" "") (car xs) "\n"))))
              (loop (cdr xs) (car step) (cadr step) #f))))))))

(define (trial:external-context root requirement)
  (trial:external-context-budget root requirement (trial:context-budget)))

(define (trial:dest ws kind)
  (string-append "out/trials/" (number->string (if (number? ws) ws 0)) "/"
                 (if (string? kind) kind "generic")))

(define (trial:safe-path? path)
  (and (string? path)
       (> (string-length path) 0)
       (not (string-prefix? path "/"))
       (not (string-contains? path ".."))))

(define (trial:quote path)
  (string-append "'" path "'"))

(define (trial:shell cmd)
  (try (shell cmd) (catch (e) 1)))

(define (trial:reset-dir! dest)
  (if (and (string? dest) (string-prefix? dest "out/trials/"))
    (trial:shell (string-append "rm -rf " (trial:quote dest)))
    1))

(define (trial:isolate kind dest)
  (let ((files (hash-ref trial:files kind #f)))
    (if (not (pair? files))
      #f
      (begin
        (trial:reset-dir! dest)
        (make-directory dest)
        (let loop ((xs files) (ok #t))
          (if (or (not ok) (not (pair? xs)))
            ok
            (let* ((rel (car xs))
                   (from (string-append "fixtures/trials/" kind "/" rel))
                   (to (string-append dest "/" rel))
                   (text (file-read from)))
              (make-directory (path-dirname to))
              (if (not (string? text))
                #f
                (begin
                  (file-write to text)
                  (loop (cdr xs) #t))))))))))

(define *trial-replace-why* "")

(define (trial:replace-why) *trial-replace-why*)

(define (trial:ws? c)
  (or (= c 32) (= c 9) (= c 10) (= c 13)))

;; Collapses whitespace to a single space and records the original
;; index of every kept character. Leading and trailing space is dropped.
(define (trial:norm text)
  (let ((n (string-length (if (string? text) text ""))))
    (let loop ((i 0) (out "") (idxs '()) (gap #f))
      (if (>= i n)
        (list out idxs)
        (let ((c (string-ref text i)))
          (if (trial:ws? c)
            (loop (+ i 1) out idxs (if (string=? out "") #f (if gap gap i)))
            (if gap
              (loop (+ i 1)
                    (string-append out " " (substring text i (+ i 1)))
                    (append idxs (list gap i))
                    #f)
              (loop (+ i 1)
                    (string-append out (substring text i (+ i 1)))
                    (append idxs (list i))
                    #f))))))))

(define (trial:nth xs i)
  (if (or (not (pair? xs)) (<= i 0))
    (if (pair? xs) (car xs) #f)
    (trial:nth (cdr xs) (- i 1))))

(define (trial:exact-spans text old)
  (let ((n (string-length old))
        (lim (string-length text)))
    (let loop ((i 0) (acc '()))
      (if (> (+ i n) lim)
        (reverse acc)
        (let ((j (string-index text old i)))
          (if (or (not (number? j)) (< j 0))
            (reverse acc)
            (loop (+ j n) (cons j acc))))))))

(define (trial:fuzzy-span text old)
  (let* ((nt (trial:norm text))
         (no (trial:norm old))
         (hay (car nt))
         (needle (car no))
         (hits (trial:exact-spans hay needle)))
    (cond
      ((or (string=? needle "") (not (pair? hits))) #f)
      ((pair? (cdr hits)) 'ambiguous)
      (else
       (let* ((idxs (cadr nt))
              (at (car hits))
              (start (trial:nth idxs at))
              (end-i (trial:nth idxs (+ at (string-length needle) -1))))
         (if (and (number? start) (number? end-i))
           (list start (+ end-i 1))
           #f))))))

(define (trial:splice text start len neu)
  (string-append (substring text 0 start)
                 neu
                 (substring text (+ start len) (string-length text))))

;; Exact match first. A whitespace-normalized match is used only when
;; the exact search misses and the normalized search hits once.
(define (trial:replace-into full text old neu)
  (let ((spans (trial:exact-spans text old)))
    (cond
      ((and (pair? spans) (not (pair? (cdr spans))))
       (begin
         (file-write full (trial:splice text (car spans) (string-length old) neu))
         (set! *trial-replace-why* "")
         #t))
      ((pair? spans)
       (begin (set! *trial-replace-why* "ambiguous exact match") #f))
      (else
       (let ((fuzzy (trial:fuzzy-span text old)))
         (cond
           ((equal? fuzzy 'ambiguous)
            (begin (set! *trial-replace-why* "ambiguous whitespace match") #f))
           ((pair? fuzzy)
            (begin
              (file-write full (trial:splice text (car fuzzy) (- (cadr fuzzy) (car fuzzy)) neu))
              (set! *trial-replace-why* "")
              #t))
           (else
            (begin (set! *trial-replace-why* "OLD not found") #f))))))))

(define (trial:mutate! dest change)
  (let ((path (hash-ref change "path" ""))
        (old (hash-ref change "old" ""))
        (new (hash-ref change "new" "")))
    (if (or (not (trial:safe-path? path))
            (not (string? old)) (string=? old "")
            (not (string? new)))
      (begin (set! *trial-replace-why* "OLD not found") #f)
      (let* ((full (string-append dest "/" path))
             (text (file-read full)))
        (if (not (string? text))
          (begin (set! *trial-replace-why* "OLD not found") #f)
          (trial:replace-into full text old new))))))

(define (trial:diff-path raw)
  (let ((s (string-trim (if (string? raw) raw ""))))
    (cond
      ((string=? s "/dev/null") "/dev/null")
      ((string-prefix? s "a/") (substring s 2 (string-length s)))
      ((string-prefix? s "b/") (substring s 2 (string-length s)))
      (else s))))

(define (trial:join-nl xs)
  (if (pair? xs) (string-join (reverse xs) "\n") ""))

(define (trial:flush-hunk hunks hunk)
  (if hunk (cons (reverse hunk) hunks) hunks))

(define (trial:flush-file path new? hunks hunk files)
  (if path
    (cons (list path new? (reverse (trial:flush-hunk hunks hunk))) files)
    files))

;; One unified diff becomes ((path new? hunk-line-lists) ...) in file order.
(define (trial:split-diff text)
  (let loop ((xs (text:lines (if (string? text) text "")))
             (old-path #f)
             (path #f)
             (new? #f)
             (hunks '())
             (hunk #f)
             (files '()))
    (if (not (pair? xs))
      (reverse (trial:flush-file path new? hunks hunk files))
      (let ((line (car xs)))
        (cond
          ((string-prefix? line "--- ")
           (loop (cdr xs) (trial:diff-path (text:after line "--- "))
                 path new? hunks hunk files))
          ((string-prefix? line "+++ ")
           (let* ((np (trial:diff-path (text:after line "+++ ")))
                  (use (if (string=? np "/dev/null")
                         (if (string? old-path) old-path "")
                         np))
                  (created (string=? (if (string? old-path) old-path "") "/dev/null")))
             (loop (cdr xs) old-path use created '() #f
                   (trial:flush-file path new? hunks hunk files))))
          ((string-prefix? line "@@")
           (loop (cdr xs) old-path path new?
                 (trial:flush-hunk hunks hunk) '() files))
          ((or (not path) (string-prefix? line "diff ") (string-prefix? line "index ")
               (string-prefix? line "\\"))
           (loop (cdr xs) old-path path new? hunks hunk files))
          (else
           (loop (cdr xs) old-path path new? hunks (cons line (if hunk hunk '())) files)))))))

(define (trial:patch-path diff)
  (let ((files (trial:split-diff diff)))
    (if (pair? files) (car (car files)) #f)))

(define (trial:patch-body diff sign)
  sign
  "")

(define (trial:hunk-pair lines)
  (let loop ((xs lines) (old '()) (new '()))
    (if (not (pair? xs))
      (list (trial:join-nl old) (trial:join-nl new))
      (let ((line (car xs)))
        (cond
          ((or (string=? line "") (string-prefix? line "@@") (string-prefix? line "\\"))
           (loop (cdr xs) old new))
          ((string-prefix? line "+")
           (loop (cdr xs) old (cons (substring line 1 (string-length line)) new)))
          ((string-prefix? line "-")
           (loop (cdr xs) (cons (substring line 1 (string-length line)) old) new))
          ((string-prefix? line " ")
           (let ((body (substring line 1 (string-length line))))
             (loop (cdr xs) (cons body old) (cons body new))))
          (else (loop (cdr xs) old new)))))))

(define (trial:ensure-nl body)
  (let ((t (if (string? body) body "")))
    (let ((n (string-length t)))
      (if (and (> n 0) (string=? (substring t (- n 1) n) "\n"))
        t
        (string-append t "\n")))))

(define (trial:write-new dest path body)
  (let ((full (string-append dest "/" path)))
    (make-directory (path-dirname full))
    (file-write full (trial:ensure-nl body))
    #t))

(define (trial:apply-hunk dest path new? hunk n)
  (let* ((pair (trial:hunk-pair hunk))
         (old (car pair))
         (neu (cadr pair))
         (full (string-append dest "/" path))
         (text (file-read full)))
    (cond
      ((not (trial:safe-path? path))
       (hash "ok" #f "hunk" n "old" path "now" "refused path"))
      ((and new? (or (not (string? text)) (string=? text "")) (string=? old ""))
       (begin (trial:write-new dest path neu)
              (hash "ok" #t "hunk" n "old" "" "now" (trial:clip neu 240))))
      ((not (string? text))
       (hash "ok" #f "hunk" n "old" (trial:clip old 160) "now" "missing file"))
      ((string=? old "")
       (hash "ok" #f "hunk" n "old" "" "now" (trial:clip text 240)))
      ((trial:replace-into full text old neu)
       (hash "ok" #t "hunk" n "old" "" "now" ""))
      (else
       (hash "ok" #f "hunk" n "old" (trial:clip old 160)
             "now" (trial:clip (string-append (trial:replace-why) "\n" text) 240))))))

(define (trial:apply-diff dest change)
  (let ((task (hash-ref change "task" ""))
        (files (trial:split-diff (hash-ref change "diff" ""))))
    (if (not (pair? files))
      (list (hash "task" task "path" "" "ok" #f "hunk" 0
                  "prior" #f "old" "empty diff" "now" ""))
      (let file-loop ((fs files) (acc '()))
        (if (not (pair? fs))
          acc
          (let* ((file (car fs))
                 (path (car file))
                 (new? (cadr file))
                 (hunks (caddr file)))
            (if (not (pair? hunks))
              (file-loop (cdr fs)
                         (append acc (list (hash "task" task "path" path "ok" #f
                                                 "hunk" 0 "prior" #f
                                                 "old" "no hunk" "now" ""))))
              (let hunk-loop ((hs hunks) (n 1) (rows '()) (failed #f))
                (if (or failed (not (pair? hs)))
                  (file-loop (cdr fs) (append acc (reverse rows)))
                  (let ((row (trial:apply-hunk dest path new? (car hs) n)))
                    (hunk-loop (cdr hs) (+ n 1)
                               (cons (hash "task" task "path" path
                                           "ok" (hash-ref row "ok" #f)
                                           "hunk" (hash-ref row "hunk" n)
                                           "prior" #f
                                           "old" (hash-ref row "old" "")
                                           "now" (hash-ref row "now" ""))
                                     rows)
                               (not (hash-ref row "ok" #f)))))))))))))

(define (trial:patch! dest change)
  (let ((rows (trial:apply-diff dest change)))
    (let loop ((xs rows))
      (cond
        ((not (pair? xs)) #t)
        ((hash-ref (car xs) "ok" #f) (loop (cdr xs)))
        (else #f)))))

(define (trial:apply-one dest change)
  (if (not (hash? change))
    #f
    (cond
      ((equal? (hash-ref change "kind" "") "mutate") (trial:mutate! dest change))
      ((equal? (hash-ref change "kind" "") "patch") (trial:patch! dest change))
      (else #f))))

(define (trial:change-path change)
  (let ((path (hash-ref change "path" #f)))
    (if (and (string? path) (> (string-length path) 0))
      path
      (let ((from-diff (trial:patch-path (hash-ref change "diff" ""))))
        (if (string? from-diff) from-diff "")))))

(define (trial:change-old change)
  (let ((old (hash-ref change "old" #f)))
    (if (and (string? old) (> (string-length old) 0))
      old
      (trial:patch-body (hash-ref change "diff" "") "-"))))

(define (trial:mutate-row dest change)
  (let* ((path (if (hash? change) (trial:change-path change) ""))
         (ok (and (hash? change) (trial:apply-one dest change)))
         (now (file-read (string-append dest "/" path))))
    (list (hash "task" (if (hash? change) (hash-ref change "task" "") "")
                "path" path
                "ok" (if ok #t #f)
                "hunk" 0
                "prior" #f
                "old" (trial:clip (if (hash? change) (trial:change-old change) "") 160)
                "now" (trial:clip
                       (string-append
                         (if ok "" (string-append (trial:replace-why) "\n"))
                         (if (string? now) now ""))
                       240)))))

(define (trial:seen? path seen)
  (let loop ((ys seen))
    (cond
      ((not (pair? ys)) #f)
      ((equal? (car ys) path) #t)
      (else (loop (cdr ys))))))

(define (trial:mark-prior rows seen)
  (map (lambda (r)
         (if (and (hash? r) (trial:seen? (hash-ref r "path" "") seen))
           (begin (hash-set! r "prior" #t) r)
           r))
       rows))

(define (trial:apply-report dest changes)
  (let loop ((xs (if (pair? changes) changes '())) (acc '()) (seen '()))
    (if (not (pair? xs))
      (reverse acc)
      (let* ((change (car xs))
             (raw (if (and (hash? change) (equal? (hash-ref change "kind" "") "patch"))
                    (trial:apply-diff dest change)
                    (trial:mutate-row dest change)))
             (rows (trial:mark-prior raw seen)))
        (loop (cdr xs)
              (append (reverse rows) acc)
              (let add ((rs rows) (seen seen))
                (if (not (pair? rs))
                  seen
                  (let ((path (hash-ref (car rs) "path" "")))
                    (add (cdr rs)
                         (if (and (hash-ref (car rs) "ok" #f) (> (string-length path) 0))
                           (cons path seen)
                           seen))))))))))

(define (trial:applied-word report)
  (let loop ((xs report) (n 0) (bad 0))
    (if (not (pair? xs))
      (cond
        ((= n 0) "none")
        ((= bad 0) "all")
        (else "partial"))
      (loop (cdr xs) (+ n 1) (if (hash-ref (car xs) "ok" #f) bad (+ bad 1))))))

(define (trial:format-report report)
  (let loop ((xs report) (out ""))
    (if (not (pair? xs))
      out
      (let ((r (car xs)))
        (loop (cdr xs)
              (string-append out
                "apply task=" (hash-ref r "task" "")
                " path=" (hash-ref r "path" "")
                " result=" (if (hash-ref r "ok" #f) "pass" "fail")
                (let ((h (hash-ref r "hunk" 0)))
                  (if (and (number? h) (> h 0) (not (hash-ref r "ok" #f)))
                    (string-append " hunk=" (number->string h))
                    ""))
                "\n"
                (if (hash-ref r "ok" #f)
                  ""
                  (string-append
                    (if (hash-ref r "prior" #f)
                      "file already changed by an earlier task\n"
                      "")
                    (if (string-contains? (hash-ref r "now" "") "ambiguous")
                      "OLD ambiguous:\n"
                      "OLD not found:\n")
                    (hash-ref r "old" "") "\n"
                    "file now:\n" (hash-ref r "now" "") "\n"))))))))

(define (trial:wants? contract key)
  (let loop ((xs contract))
    (cond
      ((not (pair? xs)) #f)
      ((and (pair? (car xs)) (equal? (car (car xs)) key)) #t)
      (else (loop (cdr xs))))))

(define *trial-log* "")
(define *trial-report* '())

(define (trial:last-log) *trial-log*)
(define (trial:last-report) *trial-report*)

(define (trial:clear!)
  (set! *trial-log* "")
  (set! *trial-report* '()))

(define (trial:clip s n)
  (let ((t (if (string? s) s "")))
    (if (<= (string-length t) n) t (substring t 0 n))))

(define (trial:note! s)
  (set! *trial-log* (trial:clip s 1200)))

;; An unbound "std/string:string-split-words" is the model joining the
;; import hint to the bare name. Say so in the feedback.
(define (trial:unbound-hint text)
  (if (and (string? text)
           (string-contains? text "unbound")
           (string-contains? text ":"))
    "HINT: an unbound mod:name is not a call. After (import \"std/string\") use the bare name, for example string-split-words.\n"
    ""))

(define (trial:capture! dest)
  (let ((err (file-read (string-append dest "/test.err")))
        (out (file-read (string-append dest "/test.out"))))
    (trial:note! (string-append
                   (if (string? err) err "")
                   "\n"
                   (if (string? out) out "")))))

(define (trial:aura-test dest)
  ;; Redirects are opened after cd, so they stay inside the overlay.
  ;; A failure is retried once; see trial:test-ok?.
  (trial:test-ok? dest ""))

(define (trial:bench dest)
  (let ((out (try (command-output
                    (string-append "cd " (trial:quote dest)
                                   " && aura run --quiet bench.aura >bench.out 2>/dev/null && cat bench.out"))
                  (catch (e) ""))))
    (if (string? out) out "")))

(define (trial:parse-bench text)
  (let loop ((lines (text:lines (if (string? text) text ""))) (acc '()))
    (if (not (pair? lines))
      acc
      (let ((line (string-trim (car lines))))
        (if (or (string-prefix? line "p99=")
                (string-prefix? line "budget=")
                (string-prefix? line "tests="))
          (loop (cdr lines) (append acc (text:pairs line)))
          (loop (cdr lines) acc))))))

(define (trial:has-bench? dest)
  (file-exists? (string-append dest "/bench.aura")))

(define (trial:observe dest contract)
  (let ((ran (if (or (trial:wants? contract "tests")
                     (not (pair? contract)))
               (list (list "tests" (if (trial:aura-test dest) "pass" "fail")))
               '()))
        (benched (if (or (trial:wants? contract "p99")
                         (trial:wants? contract "budget"))
                   (if (trial:has-bench? dest)
                     (trial:parse-bench (trial:bench dest))
                     (append
                       (if (trial:wants? contract "p99") '(("p99" "no-bench")) '())
                       (if (trial:wants? contract "budget") '(("budget" "no-bench")) '())))
                   '())))
    (trial:capture! dest)
    (let ((observed (append ran benched)))
      (map (lambda (p)
             (let ((got (text:lookup observed (car p))))
               (list (car p) (if (string? got) got "missing"))))
           contract))))

;; Copy the seed, apply what fits, and still run the checks. A change
;; that does not apply is recorded; it does not skip the test. The
;; evidence includes applied=all|partial|none so a passing test cannot
;; hide a patch that never landed.
(define (trial:snapshot! dest)
  (let ((base (string-append dest "-base")))
    (trial:shell (string-append "rm -rf " (trial:quote base)))
    (if (= (trial:shell (string-append "cp -a " (trial:quote dest) " " (trial:quote base))) 0)
      base
      #f)))

(define *trial-unstable* #f)

(define (trial:unstable?) *trial-unstable*)

(define (trial:reset-unstable!)
  (set! *trial-unstable* #f))

(define (trial:test-once dir args)
  (= (trial:shell (string-append "cd " (trial:quote dir)
                                 " && aura test " args
                                 " >test.out 2>test.err"))
     0))

;; A red run is tried once more. A pass after a failure is recorded
;; as unstable instead of failing the patch.
(define (trial:test-ok? dir args)
  (if (trial:test-once dir args)
    #t
    (if (trial:test-once dir args)
      (begin (set! *trial-unstable* #t) #t)
      #f)))

(define (trial:aura-fail? dir args)
  (not (trial:test-ok? dir args)))

(define (trial:changed-tests base dest)
  (let ((out (try (command-output
                    (string-append "cd " (trial:quote dest)
                                   " && { find tests -type f -name '*.aura'; find tests -type f -name '*.golden'; } 2>/dev/null"))
                  (catch (e) ""))))
    (let loop ((xs (text:lines (if (string? out) out ""))) (acc '()))
      (if (not (pair? xs))
        (reverse acc)
        (let ((rel (string-trim (car xs))))
          (if (or (string=? rel "") (not (trial:safe-path? rel)))
            (loop (cdr xs) acc)
            (let ((a (file-read (string-append dest "/" rel)))
                  (b (file-read (string-append base "/" rel))))
              (loop (cdr xs)
                    (if (equal? a b) acc (cons rel acc))))))))))

(define (trial:aura-name? rel)
  (let ((n (string-length rel)))
    (and (> n 5) (string=? (substring rel (- n 5) n) ".aura"))))

(define (trial:test-args files)
  (let loop ((xs files) (acc '()))
    (if (not (pair? xs))
      (if (pair? acc) (string-join (reverse acc) " ") "")
      (loop (cdr xs)
            (if (trial:aura-name? (car xs)) (cons (car xs) acc) acc)))))

(define (trial:red-tree base dest files)
  (let ((red (string-append base "-red")))
    (trial:shell (string-append "rm -rf " (trial:quote red)))
    (trial:shell (string-append "cp -a " (trial:quote base) " " (trial:quote red)))
    (for-each (lambda (rel)
                (make-directory (path-dirname (string-append red "/" rel)))
                (file-write (string-append red "/" rel)
                            (let ((t (file-read (string-append dest "/" rel))))
                              (if (string? t) t ""))))
              files)
    red))

(define (trial:redgreen-why rg)
  (cond
    ((equal? rg "pass") "redgreen=pass 修复前测试失败，修复后通过\n")
    ((equal? rg "bench") "redgreen=bench 修复前 bench 未达标，修复后达标\n")
    ((equal? rg "speed") "redgreen=speed 输出一致且耗时改善超过阈值\n")
    ((equal? rg "apply-failed") "redgreen=apply-failed 补丁没有落地\n")
    ((equal? rg "not-red") "redgreen=not-red 修复前测试已经通过，没有先红\n")
    ((equal? rg "still-red") "redgreen=still-red 修复后测试仍失败\n")
    ((equal? rg "no-bench") "redgreen=no-bench 无 bench\n")
    ((equal? rg "missing-file") "redgreen=missing-file 新测试没有因断言失败，失败原因是缺文件\n")
    ((equal? rg "tamper") "redgreen=tamper 改了既有 golden 或既有测试，任务没有要求\n")
    (else (string-append "redgreen=" (if (string? rg) rg "") "\n"))))

(define (trial:no-bench-note evidence)
  (let loop ((xs evidence))
    (cond
      ((not (pair? xs)) "")
      ((and (pair? (car xs)) (equal? (cadr (car xs)) "no-bench"))
       "无 bench\n")
      (else (loop (cdr xs))))))

(define (trial:speedup)
  (let ((v (getenv "AURA_AGENTS_SPEEDUP")))
    (let ((n (if (and (string? v) (> (string-length v) 0)) (string->number v) #f)))
      (if (and (number? n) (> n 1)) n 2))))

(define (trial:toml-entry dest)
  (let ((text (file-read (string-append dest "/aura.toml"))))
    (if (not (string? text))
      #f
      (let loop ((xs (text:lines text)))
        (if (not (pair? xs))
          #f
          (let ((line (string-trim (car xs))))
            (if (string-prefix? line "entry")
              (let ((q1 (string-index line "\"" 0)))
                (if (or (not (number? q1)) (< q1 0))
                  #f
                  (let ((q2 (string-index line "\"" (+ q1 1))))
                    (if (or (not (number? q2)) (< q2 0))
                      #f
                      (substring line (+ q1 1) q2)))))
              (loop (cdr xs)))))))))

(define (trial:src-changed? changed)
  (let loop ((xs changed))
    (cond
      ((not (pair? xs)) #f)
      ((and (not (string-prefix? (car xs) "tests/"))
            (not (string-contains? (car xs) "bench")))
       #t)
      (else (loop (cdr xs))))))

(define (trial:existed? base rel)
  (string? (file-read (string-append base "/" rel))))

;; Time the project entry when a source file changed, and any new or
;; changed bench. The clock is the harness, not a number the worker prints.
(define (trial:displays? dest rel)
  (let ((body (file-read (string-append dest "/" rel))))
    (and (string? body) (string-contains? body "(display"))))

(define (trial:time-targets base dest)
  (let ((changed (trial:changed-aura base dest))
        (entry (trial:toml-entry dest)))
    (let loop ((xs changed)
               (acc (if (and (string? entry) (> (string-length entry) 0)
                             (trial:src-changed? changed)
                             (trial:displays? dest entry))
                      (list entry)
                      '())))
      (if (not (pair? xs))
        acc
        (loop (cdr xs)
              (if (and (string-contains? (car xs) "bench")
                       (not (equal? (car xs) entry)))
                (cons (car xs) acc)
                acc))))))

(define (trial:measure dir rel)
  (let ((code (trial:shell
                (string-append
                  "cd " (trial:quote dir)
                  " && start=$(date +%s%N) && aura run --quiet " (trial:quote rel)
                  " >timed.out 2>/dev/null; status=$?; end=$(date +%s%N);"
                  " echo $(( (end - start) / 1000000 )) >timed.ms; exit $status"))))
    (let ((out (file-read (string-append dir "/timed.out")))
          (ms (file-read (string-append dir "/timed.ms"))))
      (list (if (string? out) out "")
            (let ((n (string->number (string-trim (if (string? ms) ms "")))))
              (if (number? n) n 0))
            (= code 0)))))

(define (trial:old-tree base dest targets)
  (let loop ((xs targets) (neu '()))
    (if (not (pair? xs))
      (if (pair? neu) (trial:red-tree base dest (reverse neu)) base)
      (loop (cdr xs)
            (if (trial:existed? base (car xs)) neu (cons (car xs) neu))))))

(define (trial:harness-speed base dest requirement)
  (if (not (contract:speed? requirement))
    #f
    (let ((files (trial:time-targets base dest)))
      (if (not (pair? files))
        #f
        (let ((before (trial:old-tree base dest files)))
          (let loop ((xs files) (bms 0) (ams 0) (ok #t))
            (if (or (not ok) (not (pair? xs)))
              (if (and ok (> bms 0) (<= (* ams (trial:speedup)) bms))
                "speed"
                #f)
              (let ((b (trial:measure before (car xs)))
                    (a (trial:measure dest (car xs))))
                (loop (cdr xs)
                      (+ bms (cadr b))
                      (+ ams (cadr a))
                      (and (caddr b) (caddr a) (string=? (car b) (car a))))))))))))

(define (trial:fail-kind text)
  (let ((s (if (string? text) text "")))
    (cond
      ((or (string-contains? s "cannot resolve")
           (string-contains? s "No such file")
           (string-contains? s "no such file")
           (string-contains? s "not found"))
       "missing-file")
      ((string-contains? s "stdout differs") "assert")
      (else "other"))))

(define (trial:tampered base dest)
  (let loop ((xs (trial:changed-tests base dest)) (acc '()))
    (if (not (pair? xs))
      (reverse acc)
      (loop (cdr xs)
            (if (trial:existed? base (car xs)) (cons (car xs) acc) acc)))))

(define (trial:tamper? base dest requirement)
  (and (not (contract:allows-test-edit? requirement))
       (pair? (trial:tampered base dest))))

(define (trial:changed-aura base dest)
  (let ((out (try (command-output
                    (string-append "cd " (trial:quote dest)
                                   " && find . -type f -name '*.aura' 2>/dev/null"))
                  (catch (e) ""))))
    (let loop ((xs (text:lines (if (string? out) out ""))) (acc '()))
      (if (not (pair? xs))
        (reverse acc)
        (let ((raw (string-trim (car xs))))
          (let ((rel (if (string-prefix? raw "./")
                       (substring raw 2 (string-length raw))
                       raw)))
            (if (or (string=? rel "") (not (trial:safe-path? rel)))
              (loop (cdr xs) acc)
              (let ((a (file-read (string-append dest "/" rel)))
                    (b (file-read (string-append base "/" rel))))
                (loop (cdr xs)
                      (if (equal? a b) acc (cons rel acc)))))))))))

;; New or modified tests must fail on the untouched sources and the
;; full suite must pass after the edit. A pure metric change can
;; instead show a bench that was not ok before and is ok after.
;; A performance task can also show equivalent output and a real speedup.
(define (trial:redgreen base dest contract requirement)
  (let ((changed (trial:changed-tests base dest))
        (green (not (trial:aura-fail? dest "")))
        (metric (or (trial:wants? contract "p99") (trial:wants? contract "budget")))
        (speed (trial:harness-speed base dest requirement)))
    (cond
      ((trial:tamper? base dest requirement) "tamper")
      ((and green (equal? speed "speed")) "speed")
      ((pair? changed)
       (let* ((red (trial:red-tree base dest changed))
              (red-fail (trial:aura-fail? red (trial:test-args changed)))
              (kind (trial:fail-kind (file-read (string-append red "/test.out")))))
         (cond
           ((and red-fail (equal? kind "missing-file")) "missing-file")
           ((not green) "still-red")
           ((not red-fail) "not-red")
           ((equal? kind "assert") "pass")
           (else "not-red"))))
      ((and metric (trial:has-bench? dest))
       (let ((before (trial:parse-bench (trial:bench base)))
             (after (trial:parse-bench (trial:bench dest))))
         (let ((b (text:lookup before "p99"))
               (a (text:lookup after "p99")))
           (cond
             ((not (string? a)) "no-bench")
             ((and (equal? a "ok") (not (equal? b "ok"))) "bench")
             ((not green) "still-red")
             (else "not-red")))))
      ((not green) "still-red")
      ((not (trial:aura-fail? base "")) "not-red")
      (else "pass"))))

(define (trial:prepare ws requirement)
  (let ((root (trial:root))
        (kind (contract:kind requirement))
        (dest (trial:dest ws (if (trial:root) "external" (contract:kind requirement)))))
    (if root
      (if (trial:copy-tree root dest) dest #f)
      (if (trial:isolate kind dest) dest #f))))

(define *trial-dest* #f)
(define *trial-base* #f)

(define (trial:current-dest) *trial-dest*)

(define (trial:evidence dest base requirement contract report)
  (let ((tests (trial:observe dest contract))
        (word (trial:applied-word report))
        (rg (if (not (equal? word "all"))
              "apply-failed"
              (if base (trial:redgreen base dest contract requirement) "not-red"))))
    (set! *trial-report* report)
    (trial:note! (string-append (trial:format-report report)
                                (trial:redgreen-why rg)
                                (if (trial:unstable?) "test-unstable=yes\n" "")
                                (trial:no-bench-note tests)
                                (trial:unbound-hint (trial:last-log))
                                "TEST\n"
                                (trial:last-log)))
    (append tests
            (list (list "applied" word) (list "redgreen" rg))
            (if (trial:unstable?) (list (list "test-unstable" "yes")) '()))))

(define (trial:verdict ws requirement contract changes)
  (let* ((dest (trial:prepare ws requirement))
         (ready (string? dest)))
    (if (not ready)
      (begin
        (set! *trial-report* '())
        (set! *trial-dest* #f)
        (trial:note! "isolate failed")
        (append (map (lambda (p) (list (car p) "missing")) contract)
                (list (list "applied" "none"))))
      (let ((base (trial:snapshot! dest)))
        (trial:reset-unstable!)
        (set! *trial-dest* dest)
        (set! *trial-base* base)
        (let ((report (trial:apply-report dest (if (pair? changes) changes '()))))
          (trial:evidence dest base requirement contract report))))))

(define (trial:same-row? a b)
  (and (equal? (hash-ref a "task" "") (hash-ref b "task" ""))
       (equal? (hash-ref a "path" "") (hash-ref b "path" ""))))

(define (trial:merge-rows old neu)
  (append (filter (lambda (r)
                    (not (let loop ((xs neu))
                           (cond
                             ((not (pair? xs)) #f)
                             ((trial:same-row? r (car xs)) #t)
                             (else (loop (cdr xs)))))))
                  (if (pair? old) old '()))
          (if (pair? neu) neu '())))

(define (trial:apply-more dest changes)
  (let ((rows (trial:apply-report dest (if (pair? changes) changes '()))))
    (set! *trial-report* (trial:merge-rows (trial:last-report) rows))
    rows))

(define (trial:rejudge requirement contract)
  (if (not (string? *trial-dest*))
    '()
    (trial:evidence *trial-dest* *trial-base* requirement contract (trial:last-report))))

(define (trial:conflict-rows report)
  (filter (lambda (r)
            (and (hash? r)
                 (not (hash-ref r "ok" #f))
                 (hash-ref r "prior" #f)))
          (if (pair? report) report '())))

(define (trial:rebase-note dest row)
  (let* ((path (hash-ref row "path" ""))
         (body (file-read (string-append dest "/" path))))
    (string-append "rebase\nCURRENT " path "\n" (if (string? body) body ""))))

;; ── deterministic worker reply (mock) ─────────────────────────
;; The strings match fixtures/trials. A cheat reply still says tests=pass
;; and writes a form that the fixture's own test rejects.

(define (trial:has? text needle)
  (and (string? text) (string-contains? text needle)))

(define (trial:fail? text) (trial:has? text "SIMULATE-FAIL"))
(define (trial:cheat? text) (trial:has? text "SIMULATE-CHEAT"))
(define (trial:retry-bad? text)
  (and (trial:has? text "SIMULATE-RETRY") (not (trial:has? text "FEEDBACK"))))

(define (trial:task-name text)
  (cond
    ((trial:has? text "implement-zrangebyscore") "implement-zrangebyscore")
    ((trial:has? text "check-p99") "check-p99")
    ((trial:has? text "implement-word-count") "implement-word-count")
    ((trial:has? text "optimize-hot-path") "optimize-hot-path")
    ((trial:has? text "implement-change") "implement-change")
    (else "implement-change")))

(define (trial:result-line text)
  (cond
    ((trial:fail? text) "RESULT tests=fail p99=ok\n")
    ((equal? (contract:kind text) "redis") "RESULT tests=pass p99=ok\n")
    ((equal? (contract:kind text) "perf")
     (if (contract:budget? text)
       "RESULT tests=pass p99=ok budget=ok\n"
       "RESULT tests=pass p99=ok\n"))
    (else "RESULT tests=pass\n")))

(define (trial:block path old new)
  (string-append "MUTATE " path "\nOLD " old "\nNEW " new "\n"))

(define (trial:change-block text)
  (let ((bad (or (trial:fail? text) (trial:cheat? text) (trial:retry-bad? text)))
        (task (trial:task-name text)))
    (cond
      ((equal? task "implement-zrangebyscore")
       (trial:block "src/zset.aura"
                    "(define (zset:zrangebyscore key min max) \"missing\")"
                    (if bad
                      "(define (zset:zrangebyscore key min max) \"wrong\")"
                      "(define (zset:zrangebyscore key min max) \"1,2,3\")")))
      ((equal? task "check-p99")
       (trial:block "src/latency.aura"
                    "(define (latency:floor?) #f)"
                    (if bad
                      "(define (latency:floor?) #f)"
                      "(define (latency:floor?) #t)")))
      ((equal? task "implement-word-count")
       (trial:block "src/wc.aura"
                    "(define (wc:count text) 0)"
                    (if bad
                      "(define (wc:count text) -1)"
                      "(define (wc:count text) (length (string-split-words text)))")))
      ((equal? task "optimize-hot-path")
       (trial:block "src/hot.aura"
                    "(define (hot:cost) 100)"
                    (if bad
                      "(define (hot:cost) 1000)"
                      "(define (hot:cost) 10)")))
      (else
       (trial:block "src/marker.aura"
                    "(define (marker:done?) #f)"
                    (if bad
                      "(define (marker:done?) #f)"
                      "(define (marker:done?) #t)"))))))

(define (trial:timeout? text)
  (or (trial:has? text "SIMULATE-TIMEOUT-ALWAYS")
      (and (trial:has? text "SIMULATE-TIMEOUT")
           (not (trial:has? text "previous reply"))
           (not (trial:has? text "FEEDBACK")))))

(define (trial:worker-reply text)
  (cond
    ((trial:timeout? text) "ERROR http-post: timeout\n")
    ((and (trial:has? text "SIMULATE-GARBAGE") (not (trial:has? text "FEEDBACK")))
     "<tool_call>{\"name\":\"edit\"}</tool_call>\n")
    ((and (trial:has? text "SIMULATE-REBASE")
          (trial:has? text "TASK second")
          (trial:has? text "rebase"))
     (string-append "RESULT tests=pass\n"
                    (trial:block "src/n.aura" "(define (n:v) 1)" "(define (n:v) 2)")))
    ((and (trial:has? text "SIMULATE-REBASE") (trial:has? text "TASK first"))
     (string-append "RESULT tests=pass\n"
                    (trial:block "src/n.aura" "(define (n:v) 0)" "(define (n:v) 1)")))
    ((and (trial:has? text "SIMULATE-REBASE") (trial:has? text "TASK second"))
     (string-append "RESULT tests=pass\n"
                    (trial:block "src/n.aura" "(define (n:v) 0)" "(define (n:v) 2)")))
    (else (string-append (trial:result-line text) (trial:change-block text)))))
