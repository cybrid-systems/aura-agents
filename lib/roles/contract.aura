;; Requirement → contract. The target, the repository context and the
;; requirement are parameters. Nothing here assumes aura-redis.
(require "std/string")
(require "lib/text")

(define (contract:has? text needle)
  (and (string? text) (string? needle) (string-contains? text needle)))

;; Fixture source is injected above the REQUIREMENT marker. Kind and
;; budget detection look only at the requirement (and a trailing hint),
;; so a file that mentions p99 cannot invent a check.
(define (contract:scoped text)
  (if (not (string? text))
    ""
    (let ((i (string-index text "REQUIREMENT\n" 0)))
      (if (< i 0)
        text
        (substring text (+ i (string-length "REQUIREMENT\n")) (string-length text))))))

(define (contract:redis? text)
  (let ((s (contract:scoped text)))
    (or (contract:has? s "aura-redis")
        (contract:has? s "ZRANGEBYSCORE")
        (contract:has? s "zrangebyscore"))))

(define (contract:wordcount? text)
  (let ((s (contract:scoped text)))
    (or (contract:has? s "单词")
        (contract:has? s "词数")
        (contract:has? s "word count")
        (contract:has? s "wordcount")
        (contract:has? s "word-count")
        (contract:has? s "count words"))))

(define (contract:budget? text)
  (let ((s (contract:scoped text)))
    (or (contract:has? s "budget")
        (contract:has? s "预算")
        (contract:has? s "性能")
        (contract:has? s "优化")
        (contract:has? s "optimize"))))

;; The judge can execute only these. Anything else becomes "missing".
(define (contract:check? key)
  (or (equal? key "tests") (equal? key "p99") (equal? key "budget")))

(define (contract:perf? text)
  (let ((s (contract:scoped text)))
    (or (contract:budget? s)
        (contract:has? s "p99")
        (contract:has? s "latency"))))

;; Speed KEEP is separate from p99/budget. A render or "faster" task
;; can take that path without those checks being added.
(define (contract:speed? text)
  (let ((s (contract:scoped (if (string? text) text ""))))
    (or (contract:perf? text)
        (contract:has? s "加速")
        (contract:has? s "更快")
        (contract:has? s "faster")
        (contract:has? s "speed")
        (contract:has? s "耗时")
        (contract:has? s "渲染")
        (contract:has? s "render"))))

(define (contract:allows-test-edit? text)
  (let ((s (contract:scoped (if (string? text) text ""))))
    (or (contract:has? s "golden")
        (contract:has? s "断言")
        (contract:has? s "更新测试")
        (contract:has? s "修改测试")
        (contract:has? s "改测试")
        (contract:has? s "update test"))))

(define (contract:kind text)
  (cond
    ((contract:redis? text) "redis")
    ((contract:wordcount? text) "wordcount")
    ((contract:perf? text) "perf")
    (else "generic")))

(define (contract:target requirement given)
  (if (and (string? given) (> (string-length given) 0))
    given
    (cond
      ((contract:redis? requirement) "cybrid-systems/aura-redis")
      ((contract:wordcount? requirement) "local/wordcount")
      ((contract:perf? requirement) "local/perf")
      (else "local/project"))))

(define (contract:context given)
  (if (and (string? given) (> (string-length given) 0)) given "none"))

(define (contract:planner-user target context requirement hint)
  (string-append
    "TARGET " (if (string? target) target "") "\n"
    "CONTEXT " (if (string? context) context "") "\n"
    "REQUIREMENT\n"
    (if (string? requirement) requirement "")
    (if (and (string? hint) (> (string-length hint) 0))
      (string-append "\n\n" hint)
      "")))

(define (contract:worker-user target context requirement task . rest)
  (let ((feedback (if (and (pair? rest) (string? (car rest))) (car rest) "")))
    (string-append
      "TARGET " (if (string? target) target "") "\n"
      "CONTEXT " (if (string? context) context "") "\n"
      "TASK " (if (string? task) task "") "\n"
      "REQUIREMENT\n"
      (if (string? requirement) requirement "")
      (if (> (string-length feedback) 0)
        (string-append "\nFEEDBACK\n" feedback)
        ""))))

;; Small requirements stay one task so two patches cannot fight over
;; the same file. Redis keeps two tasks because they edit two files.
;; AURA_AGENTS_TASKS, when a positive integer, is the cap instead.
(define (contract:task-cap-of requirement env)
  (let ((n (if (and (string? env) (> (string-length env) 0))
             (string->number env)
             #f)))
    (if (and (number? n) (> n 0))
      (if (integer? n) n (inexact->exact (floor n)))
      (cond
        ((contract:has? requirement "SIMULATE-REBASE") 2)
        ((contract:redis? requirement) 2)
        (else 1)))))

(define (contract:missing? pairs key)
  (not (string? (text:lookup pairs key))))

(define (contract:wants-tests? requirement)
  (or (contract:redis? requirement)
      (contract:wordcount? requirement)
      (contract:perf? requirement)
      (contract:has? (contract:scoped requirement) "测试")
      (contract:has? (contract:scoped requirement) "test")))

(define (contract:named-p99? requirement)
  (let ((s (contract:scoped requirement)))
    (or (contract:has? s "p99")
        (contract:has? s "latency")
        (contract:has? s "延迟"))))

(define (contract:named-budget? requirement)
  (let ((s (contract:scoped requirement)))
    (or (contract:has? s "预算")
        (contract:has? s "budget"))))

;; An external tree is whatever AURA_AGENTS_TARGET copied in. Fixture
;; runs leave the root unset, so they keep the old p99/budget defaults.
(define (contract:external?)
  (let ((root (try (trial:root) (catch (e) #f))))
    (and (string? root) (> (string-length root) 0))))

(define (contract:bench-text)
  (let ((root (try (trial:root) (catch (e) #f))))
    (if (and (string? root) (> (string-length root) 0))
      (let ((t (file-read (string-append root "/bench.aura"))))
        (if (string? t) t #f))
      #f)))

(define (contract:bench-mentions? needle)
  (let ((t (contract:bench-text)))
    (and (string? t) (string-contains? t needle))))

(define (contract:wants-p99? requirement)
  (or (contract:named-p99? requirement)
      (contract:bench-mentions? "p99")
      (and (not (contract:external?)) (contract:perf? requirement))))

(define (contract:add-budget? requirement)
  (or (contract:bench-mentions? "budget")
      (if (contract:external?)
        (contract:named-budget? requirement)
        (contract:budget? requirement))))

;; Put back an executable check the requirement asked for and the model
;; omitted. An explicit value, including p99=skip, is left alone.
(define (contract:ensure requirement pairs)
  (let ((base (if (pair? pairs) pairs '())))
    (let ((with-tests (if (and (contract:wants-tests? requirement)
                               (contract:missing? base "tests"))
                        (append base (list (list "tests" "pass")))
                        base)))
      (let ((with-p99 (if (and (contract:wants-p99? requirement)
                               (contract:missing? with-tests "p99"))
                        (append with-tests (list (list "p99" "ok")))
                        with-tests)))
        (if (and (contract:add-budget? requirement)
                 (contract:missing? with-p99 "budget"))
          (append with-p99 (list (list "budget" "ok")))
          with-p99)))))

(define (contract:limit-tasks requirement tasks env)
  (let ((cap (contract:task-cap-of requirement env)))
    (let loop ((xs tasks) (n cap) (acc '()))
      (if (or (not (pair? xs)) (<= n 0))
        (reverse acc)
        (loop (cdr xs) (- n 1) (cons (car xs) acc))))))

(define (contract:redis-reply p99)
  (string-append
    "CONTRACT tests=pass p99=" p99 "\n"
    "TASK implement-zrangebyscore\n"
    "TASK check-p99\n"))

;; Deterministic CONTRACT/TASK text. Real models reply in this shape;
;; the mock uses the same rules so a non-redis requirement cannot come
;; back as the aura-redis contract.
(define (contract:reply text)
  (cond
    ((contract:has? text "SIMULATE-LLM-ERROR")
     "ERROR connection refused\n")
    ((contract:has? text "SIMULATE-REBASE")
     "CONTRACT tests=pass\nTASK first\nTASK second\n")
    ((contract:has? text "SIMULATE-APPEND")
     "CONTRACT tests=pass\nTASK append-case\n")
    ((contract:has? text "SIMULATE-PARTIAL")
     "CONTRACT tests=pass\nTASK half-key\n")
    ((contract:has? text "SIMULATE-TYPE")
     "CONTRACT tests=pass\nTASK type-fix\n")
    ((contract:has? text "SIMULATE-JUNK")
     "CONTRACT tests=pass\nTASK junk-keep\n")
    ((or (contract:has? text "SIMULATE-NOT-RED-STUCK")
         (contract:has? text "SIMULATE-NOT-RED"))
     "CONTRACT tests=pass\nTASK rewrite-assert\n")
    ((and (contract:has? text "SIMULATE-P99")
          (not (contract:has? text "AVOID p99")))
     (contract:redis-reply "skip"))
    ((contract:redis? text)
     (contract:redis-reply "ok"))
    ((contract:wordcount? text)
     "CONTRACT tests=pass\nTASK implement-word-count\n")
    ((contract:perf? text)
     (string-append
       "CONTRACT tests=pass p99=ok"
       (if (contract:budget? text) " budget=ok" "")
       "\nTASK optimize-hot-path\n"))
    (else
     "CONTRACT tests=pass\nTASK implement-change\n")))
