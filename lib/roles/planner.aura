;; Planner: load prompts/planner.txt, ask the LLM seam, parse the reply
;; into a contract and tasks. Role id on the bus stays 0 until
;; aura#5400 adds a planner role.
(require "std/string")
(require "lib/text")
(require "lib/llm/chat")
(require "lib/graph/query")
(require "lib/roles/contract")
(require "lib/trial/workspace")

(define *planner-dropped* '())

(define (planner:dropped) *planner-dropped*)

(define (planner:split-checks pairs)
  (let loop ((xs pairs) (keep '()) (drop '()))
    (cond
      ((not (pair? xs)) (list (reverse keep) (reverse drop)))
      ((and (pair? (car xs)) (contract:check? (car (car xs))))
       (loop (cdr xs) (cons (car xs) keep) drop))
      (else
       (loop (cdr xs) keep
             (cons (if (pair? (car xs)) (car (car xs)) "?") drop))))))

(define (planner:parse text)
  (let loop ((lines (text:lines (text:strip-noise text))) (contract #f) (tasks '()))
    (if (not (pair? lines))
      (if (and (pair? contract) (pair? tasks))
        (let* ((split (planner:split-checks contract))
               (kept (car split))
               (dropped (cadr split)))
          (set! *planner-dropped* dropped)
          (if (pair? kept)
            (list "ok" kept (reverse tasks) dropped)
            (list "error" "contract"
                  (string-append "dropped " (string-join dropped ","))
                  dropped)))
        (begin
          (set! *planner-dropped* '())
          (list "error" "parse" "need CONTRACT and TASK")))
      (let ((line (string-trim (car lines))))
        (cond
          ((string=? line "") (loop (cdr lines) contract tasks))
          ((string-prefix? line "CONTRACT ")
           (loop (cdr lines) (text:pairs (text:after line "CONTRACT ")) tasks))
          ((string-prefix? line "TASK ")
           (loop (cdr lines) contract (cons (text:after line "TASK ") tasks)))
          (else (loop (cdr lines) contract tasks)))))))

;; Read-only experience-graph injection (#5). graph may be #f or an
;; experience graph; the returned CONTRACT/TASK shape is unchanged.
(define *planner-last-hits* '())

(define (planner:last-hits) *planner-last-hits*)

(define (planner:llm-error text)
  (let ((s (string-trim (if (string? text) text ""))))
    (if (string-prefix? s "ERROR")
      (string-trim (substring s 5 (string-length s)))
      #f)))

(define (planner:dropped-of parsed)
  (if (and (pair? parsed) (pair? (cdr parsed)) (pair? (cddr parsed))
           (pair? (cdddr parsed)) (list? (cadddr parsed)))
    (cadddr parsed)
    '()))

(define (planner:finish requirement reply)
  (let ((reason (planner:llm-error reply)))
    (if (string? reason)
      (list "error" "llm" reason)
      (let ((parsed (planner:parse reply)))
        (if (not (and (pair? parsed) (equal? (car parsed) "ok")))
          parsed
          (list "ok"
                (contract:ensure requirement (cadr parsed))
                (contract:limit-tasks requirement (caddr parsed)
                                      (getenv "AURA_AGENTS_TASKS"))
                (planner:dropped-of parsed)))))))

(define (planner:ask requirement mode system user)
  (planner:finish requirement (chat:complete mode "planner" system user)))

(define (planner:plan-with requirement mode graph . rest)
  (let* ((given-target (if (pair? rest) (car rest) #f))
         (given-context (if (and (pair? rest) (pair? (cdr rest))) (cadr rest) #f))
         (target (contract:target requirement given-target))
         (context (if (and (string? given-context) (> (string-length given-context) 0))
                    given-context
                    (trial:fixture-context (contract:kind requirement))))
         (fp (query:fingerprint target requirement))
         (q (if graph
              (graph:query-for-planner graph (query:seeds requirement)
                                       (hash "fingerprint" fp))
              (hash "hint" "" "hits" '())))
         (hint (hash-ref q "hint" ""))
         (hits (hash-ref q "hits" '()))
         (system (read-file "prompts/planner.txt"))
         (user (contract:planner-user target context requirement hint)))
    (set! *planner-last-hits* hits)
    (if (not (string? system))
      (list "error" "prompt" "missing planner prompt")
      (let ((first (planner:ask requirement mode system user)))
        (if (and (pair? first) (equal? (car first) "error") (equal? (cadr first) "llm"))
          (begin
            (display "planner-retry=1")
            (newline)
            (planner:ask requirement mode system user))
          first)))))

(define (planner:plan requirement mode)
  (planner:plan-with requirement mode #f))
