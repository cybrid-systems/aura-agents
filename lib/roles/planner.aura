;; Planner: load prompts/planner.txt, ask the LLM seam, parse the reply
;; into a contract and tasks. Role id on the bus stays 0 until
;; aura#5400 adds a planner role.
(require "std/string")
(require "lib/text")
(require "lib/llm/chat")
(require "lib/graph/query")
(require "lib/roles/contract")

(define (planner:parse text)
  (let loop ((lines (text:lines text)) (contract #f) (tasks '()))
    (if (not (pair? lines))
      (if (and (pair? contract) (pair? tasks))
        (list "ok" contract (reverse tasks))
        (list "error" "parse" "need CONTRACT and TASK"))
      (let ((line (string-trim (car lines))))
        (cond
          ((string=? line "") (loop (cdr lines) contract tasks))
          ((string-prefix? line "CONTRACT ")
           (loop (cdr lines) (text:pairs (text:after line "CONTRACT ")) tasks))
          ((string-prefix? line "TASK ")
           (loop (cdr lines) contract (cons (text:after line "TASK ") tasks)))
          (else (loop (cdr lines) contract tasks)))))))

;; Read-only experience-graph injection (#5). graph may be #f or an
;; experience graph; the returned CONTRACT/TASK shape is unchanged.
(define *planner-last-hits* '())

(define (planner:last-hits) *planner-last-hits*)

(define (planner:llm-error text)
  (let ((s (string-trim (if (string? text) text ""))))
    (if (string-prefix? s "ERROR")
      (string-trim (substring s 5 (string-length s)))
      #f)))

(define (planner:plan-with requirement mode graph . rest)
  (let* ((given-target (if (pair? rest) (car rest) #f))
         (given-context (if (and (pair? rest) (pair? (cdr rest))) (cadr rest) #f))
         (target (contract:target requirement given-target))
         (context (contract:context given-context))
         (fp (query:fingerprint target requirement))
         (q (if graph
              (graph:query-for-planner graph (query:seeds requirement)
                                       (hash "fingerprint" fp))
              (hash "hint" "" "hits" '())))
         (hint (hash-ref q "hint" ""))
         (hits (hash-ref q "hits" '()))
         (system (read-file "prompts/planner.txt"))
         (user (contract:planner-user target context requirement hint)))
    (set! *planner-last-hits* hits)
    (if (not (string? system))
      (list "error" "prompt" "missing planner prompt")
      (let ((reply (chat:complete mode "planner" system user)))
        (let ((reason (planner:llm-error reply)))
          (if (string? reason)
            (list "error" "llm" reason)
            (planner:parse reply)))))))

(define (planner:plan requirement mode)
  (planner:plan-with requirement mode #f))
