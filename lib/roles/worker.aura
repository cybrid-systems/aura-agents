;; Worker: load prompts/worker.txt and turn one task into a self-report
;; plus a patch or a form replacement. The self-report is not the verdict.
;; Role id on the bus stays 0 until aura#5400 adds a worker role.
(require "std/string")
(require "lib/text")
(require "lib/llm/chat")

(define (worker:join xs)
  (if (pair? xs) (string-join xs "\n") ""))

(define (worker:take-block lines marker)
  (let loop ((ys lines) (acc '()))
    (cond
      ((not (pair? ys)) (list (reverse acc) '()))
      ((or (string=? (string-trim (car ys)) marker)
           (string=? (string-trim (car ys)) ">>"))
       (list (reverse acc) (cdr ys)))
      (else (loop (cdr ys) (cons (car ys) acc))))))

;; lines begins at the MUTATE line. Returns (change remaining) or (#f lines).
(define (worker:read-mutate lines)
  (let ((path (string-trim (text:after (string-trim (car lines)) "MUTATE ")))
        (rest (cdr lines)))
    (if (not (pair? rest))
      (list #f lines)
      (let ((a (string-trim (car rest))))
        (cond
          ((and (string-prefix? a "OLD ")
                (pair? (cdr rest))
                (string-prefix? (string-trim (cadr rest)) "NEW "))
           (list (hash "kind" "mutate" "path" path
                       "old" (text:after a "OLD ")
                       "new" (text:after (string-trim (cadr rest)) "NEW "))
                 (cddr rest)))
          ((or (string=? a "OLD") (string=? a "OLD<<"))
           (let* ((old-pack (worker:take-block (cdr rest) "END OLD"))
                  (after-old (cadr old-pack))
                  (b (if (pair? after-old) (string-trim (car after-old)) "")))
             (if (or (string=? b "NEW") (string=? b "NEW<<"))
               (let ((new-pack (worker:take-block (cdr after-old) "END NEW")))
                 (list (hash "kind" "mutate" "path" path
                             "old" (worker:join (car old-pack))
                             "new" (worker:join (car new-pack)))
                       (cadr new-pack)))
               (list #f rest))))
          (else (list #f rest)))))))

(define (worker:finish pairs changes patch buf)
  (let ((all (if patch
               (cons (hash "kind" "patch"
                           "diff" (string-join (reverse buf) "\n"))
                     changes)
               changes)))
    (if (pair? pairs)
      (list "ok" pairs (reverse all))
      (list "error" "parse" "no RESULT"))))

(define (worker:parse text)
  (let loop ((xs (text:lines (text:strip-noise (if (string? text) text ""))))
             (pairs #f)
             (changes '())
             (patch #f)
             (buf '()))
    (cond
      ((not (pair? xs))
       (worker:finish pairs changes patch buf))
      (patch
       (if (string=? (string-trim (car xs)) "END")
         (loop (cdr xs) pairs
               (cons (hash "kind" "patch"
                           "diff" (string-join (reverse buf) "\n"))
                     changes)
               #f '())
         (loop (cdr xs) pairs changes #t (cons (car xs) buf))))
      ((string=? (string-trim (car xs)) "PATCH")
       (loop (cdr xs) pairs changes #t '()))
      ((string-prefix? (string-trim (car xs)) "RESULT ")
       (loop (cdr xs)
             (text:pairs (text:after (string-trim (car xs)) "RESULT "))
             changes #f '()))
      ((string-prefix? (string-trim (car xs)) "MUTATE ")
       (let ((read (worker:read-mutate xs)))
         (if (hash? (car read))
           (loop (cadr read) pairs (cons (car read) changes) #f '())
           (loop (cdr xs) pairs changes #f '()))))
      (else (loop (cdr xs) pairs changes #f '())))))

(define (worker:timeout? reason)
  (or (string-contains? reason "timeout")
      (string-contains? reason "timed out")))

;; A transport ERROR is not a parse failure. Timeouts stay retryable.
(define (worker:transport text)
  (let ((s (string-trim (text:strip-noise (if (string? text) text "")))))
    (if (string-prefix? s "ERROR")
      (let ((reason (string-trim (substring s 5 (string-length s)))))
        (if (worker:timeout? reason)
          (list "error" "http-timeout" reason)
          (list "error" "llm" reason)))
      #f)))

(define (worker:run spec mode)
  (let ((system (read-file "prompts/worker.txt")))
    (if (not (string? system))
      (list "error" "prompt" "missing worker prompt")
      (let ((reply (chat:complete mode "worker" system spec)))
        (let ((bad (worker:transport reply)))
          (if bad bad (worker:parse reply)))))))
