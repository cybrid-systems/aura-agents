;; In-process stand-in for the human approval point.
;; Waits on https://github.com/cybrid-systems/aura/issues/5404
;; (bus:approve). Timeout is a denial. This module does not implement
;; the verb in Aura.
(require "lib/adapt/op")
(require "lib/adapt/journal")

(define *approve-backend* "unchecked")
(define *approvals* '())

(define (approve:reset!)
  (set! *approve-backend* "unchecked")
  (set! *approvals* '()))

(define (approve:backend) *approve-backend*)

(define (approve:ensure! session)
  (if (equal? *approve-backend* "unchecked")
    (set! *approve-backend* (adapt:classify session "approve"))
    *approve-backend*)
  *approve-backend*)

(define (approve:find object-id)
  (let loop ((xs *approvals*))
    (cond
      ((not (pair? xs)) #f)
      ((equal? (hash-ref (car xs) "id") object-id) (car xs))
      (else (loop (cdr xs))))))

(define (approve:open session object-id deadline)
  (approve:ensure! session)
  (if (equal? *approve-backend* "bus")
    (list "error" "unsupported" "bus:approve open waits on aura#5404")
    (let ((row (approve:find object-id)))
      (if row
        (begin
          (hash-set! row "decision" "pending")
          (hash-set! row "deadline" deadline)
          (list "ok" object-id))
        (begin
          (set! *approvals* (cons (hash "id" object-id
                                        "decision" "pending"
                                        "deadline" deadline)
                                  *approvals*))
          (journal:emit! "approval-requested" 0 0
                         (hash "summary" (string-append "approval requested "
                                                       (if (string? object-id) object-id "object"))
                               "facts" (hash "object" (if (string? object-id) object-id "object"))))
          (list "ok" object-id))))))

(define (approve:standin-decide object-id decision)
  (let ((row (approve:find object-id)))
    (if (not row)
      (list "error" "missing" "no approval")
      (if (not (or (equal? decision "approved") (equal? decision "denied")))
        (list "error" "validation-failed" "decision must be approved or denied")
        (begin
          (hash-set! row "decision" decision)
          (journal:emit! (if (equal? decision "approved")
                           "approval-approved" "approval-denied")
                         0 0
                         (hash "summary" (string-append "approval " decision)
                               "reason" decision
                               "facts" (hash "object" (if (string? object-id) object-id "object"))))
          (list "ok" decision))))))

(define (approve:decide session object-id decision)
  (if (equal? (approve:ensure! session) "bus")
    (bus-call "approve" session object-id decision)
    (approve:standin-decide object-id decision)))

;; now >= deadline while still pending is a timeout denial (fail closed).
(define (approve:status session object-id now)
  (if (equal? (approve:ensure! session) "bus")
    (list "error" "unsupported" "bus:approve status waits on aura#5404")
    (let ((row (approve:find object-id)))
      (if (not row)
        (list "error" "missing" "no approval")
        (begin
          (if (and (equal? (hash-ref row "decision") "pending")
                   (>= now (hash-ref row "deadline")))
            (begin
              (hash-set! row "decision" "timeout")
              (journal:emit! "approval-timeout" 0 0
                             (hash "summary" "approval timeout"
                                   "reason" "timeout"
                                   "facts" (hash "object" (if (string? object-id) object-id "object")))))
            #f)
          (list "ok" (hash-ref row "decision")))))))
