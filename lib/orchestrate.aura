;; Role orchestration over the bus that exists on Aura main today:
;; host, attach, subscribe, publish, query, trial, keep, rollback, audit.
;; Task, approval and gate verbs go through the stand-in adapters.
;; Planner and worker attach as role 0. aura#5400 has not added those
;; role ids yet; an unknown role is rejected by the host.
(require "std/bus")
(require "lib/supervisor")
(require "lib/text")
(require "lib/llm/chat")
(require "lib/roles/planner")
(require "lib/roles/worker")
(require "lib/roles/judge")
(require "lib/roles/contract")
(require "lib/trial/workspace")
(require "lib/graph/query")
(require "lib/adapt/task-board")
(require "lib/adapt/approve")
(require "lib/adapt/gate")
(require "lib/adapt/journal")
(require "lib/graph/ingest")
(require "lib/graph/invalidate")
(require "lib/graph/prune")

(define orchestrate:lines
  '("demo" "llm" "workers" "refused" "approve" "tasks" "completed"
    "gate" "result" "bus-attach"
    "task-backend" "approve-backend" "gate-backend"
    "graph" "graph-nodes" "graph-edges"
    "bus-host" "bus-publish" "bus-subscribe" "bus-query"
    "bus-trial" "bus-keep" "bus-rollback" "bus-audit" "bus-unhost"))

(define (orchestrate:ok? record)
  (and (pair? record) (equal? (car record) "ok")))

(define (orchestrate:flag record)
  (if (orchestrate:ok? record) "ok" "fail"))

(define (orchestrate:emit flags)
  (for-each
    (lambda (k)
      (display k)
      (display "=")
      (display (hash-ref flags k))
      (newline))
    orchestrate:lines))

(define (orchestrate:requirement cfg)
  (let ((given (hash-ref cfg "requirement" #f)))
    (if (and (string? given) (> (string-length given) 0))
      given
      (let ((env (getenv "AURA_AGENTS_REQUIREMENT")))
        (if (and (string? env) (> (string-length env) 0))
          env
          (let ((file (read-file "demo/requirement.txt")))
            (if (string? file)
              (string-trim file)
              "给 aura-redis 加 ZRANGEBYSCORE，p99 不退化。")))))))

(define (orchestrate:attach-workers ws n)
  (let loop ((i 0) (acc '()))
    (if (>= i n)
      (reverse acc)
      (let ((a (bus:attach "" ws 0 127 31)))
        (if (orchestrate:ok? a)
          (loop (+ i 1) (cons (cadr a) acc))
          (cons #f acc))))))

(define (orchestrate:sessions planner-a judge-a workers)
  (let ((head (if (orchestrate:ok? planner-a) (list (cadr planner-a)) '())))
    (append (if (orchestrate:ok? judge-a) (append head (list (cadr judge-a))) head)
            (filter number? workers))))

(define (orchestrate:audit-flag session)
  (let ((au (bus:audit session 0)))
    (if (and (orchestrate:ok? au) (number? (cadr au)) (> (cadr au) 0))
      "ok"
      "fail")))

(define (orchestrate:read-channel flags session)
  (hash-set! flags "bus-subscribe" (orchestrate:flag (bus:subscribe session 1)))
  (hash-set! flags "bus-query" (orchestrate:flag (bus:query session 1 0 0)))
  (hash-set! flags "bus-audit" (orchestrate:audit-flag session)))

(define (orchestrate:worker-name i)
  (string-append "w" (number->string i)))

(define (orchestrate:changes results)
  (let loop ((xs results) (acc '()))
    (if (not (pair? xs))
      acc
      (let ((ch (if (and (pair? (car xs)) (pair? (cddr (car xs))) (list? (caddr (car xs))))
                  (caddr (car xs))
                  '())))
        (loop (cdr xs) (append acc ch))))))

(define (orchestrate:self-tests results)
  (let loop ((xs results) (val "none"))
    (if (not (pair? xs))
      val
      (let ((got (if (and (pair? (car xs)) (pair? (cdr (car xs))))
                   (text:lookup (cadr (car xs)) "tests")
                   #f)))
        (cond
          ((not (string? got)) (loop (cdr xs) val))
          ((equal? got "fail") "fail")
          ((equal? val "none") (loop (cdr xs) got))
          (else (loop (cdr xs) val)))))))

(define *orchestrate-specs* '())

(define (orchestrate:note-error name ev)
  (display "worker-error=")
  (display name)
  (display " reason=")
  (display (if (and (pair? ev) (pair? (cdr ev))) (cadr ev) "fail"))
  (if (and (pair? ev) (pair? (cdr ev)) (pair? (cddr ev)) (string? (caddr ev)))
    (begin
      (display " detail=")
      (display (caddr ev)))
    #f)
  (newline))

;; One task, with a bounded number of extra replies when the model
;; returns markup or anything that is not a RESULT plus a change.
(define (orchestrate:timeout-retries)
  (let ((v (getenv "AURA_AGENTS_TIMEOUT_RETRIES")))
    (let ((n (if (and (string? v) (> (string-length v) 0)) (string->number v) 1)))
      (if (and (number? n) (>= n 0))
        (if (integer? n) n (inexact->exact (floor n)))
        1))))

;; A transport timeout is recorded as http-timeout and retried once,
;; unless AURA_AGENTS_TIMEOUT_RETRIES says otherwise. Other failures
;; use the full retry budget.
(define (orchestrate:should-retry? kind try retries timeout-retries)
  (if (equal? kind "http-timeout")
    (< try (min retries timeout-retries))
    (< try retries)))

(define (orchestrate:context-given? context)
  (and (string? context)
       (> (string-length (string-trim context)) 0)
       (not (string=? (string-trim context) "none"))))

;; An explicit CONTEXT is kept. Hit files fill only the budget that remains.
(define (orchestrate:task-context context requirement spec)
  (let ((root (trial:root))
        (seeds (string-append (if (string? requirement) requirement "")
                              "\n"
                              (if (string? spec) spec ""))))
    (if (not root)
      context
      (if (orchestrate:context-given? context)
        (let ((left (- (trial:context-budget) (string-length context))))
          (if (<= left 0)
            context
            (string-append context "\n"
                           (trial:external-context-budget root seeds left))))
        (trial:external-context root seeds)))))

(define (orchestrate:invoke name spec mode target context requirement feedback retries)
  (let ((context (orchestrate:task-context context requirement spec)))
    (let loop ((try 0) (note feedback))
      (let ((ev (worker:run (contract:worker-user target context requirement spec note) mode)))
        (if (orchestrate:ok? ev)
          ev
          (begin
            (orchestrate:note-error name ev)
            (if (orchestrate:should-retry?
                  (if (and (pair? ev) (pair? (cdr ev))) (cadr ev) "")
                  try retries (orchestrate:timeout-retries))
              (let ((note "previous reply was not a RESULT plus PATCH or MUTATE"))
                (display "worker-retry=")
                (display (+ try 1))
                (newline)
                (orchestrate:feedback-summary note)
                (loop (+ try 1) note))
              ev)))))))

;; One claim for this worker. #f when the queue is empty or the reply
;; never parsed. The pool drains in waves, so workers < tasks still
;; finishes the board instead of stopping at gate=incomplete.
(define (orchestrate:claim-one session i mode now target context requirement feedback retries)
  (let* ((name (orchestrate:worker-name i))
         (claim (task:claim session name now)))
    (if (not (orchestrate:ok? claim))
      #f
      (let* ((id (cadr claim))
             (hb (task:heartbeat session id name now))
             (spec (task:spec id))
             (ev (if (orchestrate:ok? hb)
                   (orchestrate:invoke name spec mode target context requirement feedback retries)
                   #f)))
        (if (and (orchestrate:ok? hb) (orchestrate:ok? ev))
          (begin
            (task:complete session id name now "done")
            (set! *orchestrate-specs* (append *orchestrate-specs* (list spec)))
            ev)
          (begin
            (if (not (orchestrate:ok? hb))
              (orchestrate:note-error name (list "error" "lease" "heartbeat rejected"))
              #f)
            (task:fail session id name now "worker-error")
            #f))))))

;; Claim one open task. The board stays single-threaded; the model
;; calls for a wave run together afterwards.
(define (orchestrate:claim-slot session i now)
  (let* ((name (orchestrate:worker-name i))
         (claim (task:claim session name now)))
    (if (not (orchestrate:ok? claim))
      #f
      (let* ((id (cadr claim))
             (hb (task:heartbeat session id name now)))
        (if (orchestrate:ok? hb)
          (list name id (task:spec id) session)
          (begin
            (orchestrate:note-error name (list "error" "lease" "heartbeat rejected"))
            (task:fail session id name now "worker-error")
            #f))))))

(define (orchestrate:claim-wave worker-ss now cap)
  (let loop ((ss worker-ss) (i 0) (left cap) (acc '()))
    (if (or (not (pair? ss)) (<= left 0))
      (reverse acc)
      (let ((slot (orchestrate:claim-slot (car ss) i now)))
        (if (not slot)
          (reverse acc)
          (loop (cdr ss) (+ i 1) (- left 1) (cons slot acc)))))))

(define (orchestrate:finish-slot slot ev now)
  (let ((name (car slot))
        (id (cadr slot))
        (spec (caddr slot))
        (session (cadddr slot)))
    (if (orchestrate:ok? ev)
      (begin
        (task:complete session id name now "done")
        (set! *orchestrate-specs* (append *orchestrate-specs* (list spec)))
        ev)
      (begin
        (task:fail session id name now "worker-error")
        #f))))

(define (orchestrate:run-workers worker-ss mode now target context requirement feedback retries)
  (set! *orchestrate-specs* '())
  (let ((cap (orchestrate:parallel-cap (length (filter number? worker-ss)))))
    (let wave ((acc '()))
      (let ((slots (orchestrate:claim-wave worker-ss now cap)))
        (if (not (pair? slots))
          (reverse acc)
          (let* ((evs (orchestrate:map-parallel
                        (map (lambda (slot)
                               (lambda ()
                                 (orchestrate:invoke (car slot) (caddr slot) mode target
                                                     context requirement feedback retries)))
                             slots)))
                 (step (let each ((ss slots) (es evs) (acc acc) (progress #f))
                         (if (or (not (pair? ss)) (not (pair? es)))
                           (list acc progress)
                           (let ((done (orchestrate:finish-slot (car ss) (car es) now)))
                             (each (cdr ss) (cdr es)
                                   (if (orchestrate:ok? done) (cons done acc) acc)
                                   (or progress (orchestrate:ok? done))))))))
            (if (cadr step)
              (wave (car step))
              (reverse (car step)))))))))

(define (orchestrate:changes-of ev task)
  (let ((chs (if (and (pair? ev) (pair? (cdr ev)) (pair? (cddr ev)) (list? (caddr ev)))
               (caddr ev)
               '())))
    (map (lambda (c)
           (if (hash? c) (begin (hash-set! c "task" task) c) c))
         chs)))

;; A later task whose OLD missed because an earlier task already wrote
;; the file is asked once more, against the current file.
(define (orchestrate:rebase-once mode target context requirement contract evidence)
  (let ((dest (trial:current-dest))
        (rows (trial:conflict-rows (trial:last-report))))
    (if (or (not (string? dest)) (not (pair? rows)))
      evidence
      (begin
        (display "rebase-retry=1")
        (newline)
        (for-each
          (lambda (row)
            (let* ((task (hash-ref row "task" ""))
                   (note (trial:rebase-note dest row))
                   (ev (worker:run (contract:worker-user
                                     target
                                     (orchestrate:task-context context requirement task)
                                     requirement task note)
                                   mode)))
              (if (orchestrate:ok? ev)
                (trial:apply-more dest (orchestrate:changes-of ev task))
                #f)))
          rows)
        (trial:rejudge requirement contract)))))

(define (orchestrate:tests-failed? evidence)
  (let ((got (text:lookup evidence "tests")))
    (or (not (string? got)) (equal? got "fail") (equal? got "missing"))))

(define (orchestrate:need-retry? evidence)
  (or (orchestrate:tests-failed? evidence)
      (let ((applied (text:lookup evidence "applied")))
        (and (string? applied) (not (equal? applied "all"))))))

(define (orchestrate:tag-changes results)
  (let loop ((rs results) (ss *orchestrate-specs*) (acc '()))
    (if (or (not (pair? rs)) (not (pair? ss)))
      acc
      (let ((chs (if (and (pair? (cddr (car rs))) (list? (caddr (car rs))))
                   (caddr (car rs))
                   '())))
        (loop (cdr rs) (cdr ss)
              (append acc
                      (map (lambda (c)
                             (if (hash? c)
                               (begin (hash-set! c "task" (car ss)) c)
                               c))
                           chs)))))))

(define (orchestrate:feedback-summary text)
  (let ((flat (string-replace (trial:clip (if (string? text) text "") 160) "\n" " ")))
    (display "feedback-summary=")
    (display flat)
    (newline)))

(define (orchestrate:parallel-cap nworkers)
  (let ((env (getenv "AURA_AGENTS_PARALLEL")))
    (let ((n (if (and (string? env) (> (string-length env) 0)) (string->number env) #f)))
      (let ((cap (if (and (number? n) (> n 0))
                   (if (integer? n) n (inexact->exact (floor n)))
                   nworkers)))
        (if (<= nworkers 0) 0 (min nworkers cap))))))

(define (orchestrate:spawn-ok? id)
  (and (number? id) (> id 0)))

;; Run thunks together when fibers exist. Join in spawn order.
;; A failed spawn runs the thunks one by one instead.
(define (orchestrate:map-parallel thunks)
  (if (not (pair? thunks))
    '()
    (if (not (pair? (cdr thunks)))
      (list ((car thunks)))
      (let ((probe (try (fiber:spawn (lambda () #t)) (catch (e) 0))))
        (if (not (orchestrate:spawn-ok? probe))
          (begin
            (display "parallel=serial")
            (newline)
            (map (lambda (th) (th)) thunks))
          (begin
            (try (fiber:join probe) (catch (e) #f))
            (let ((ids (map (lambda (th)
                              (try (fiber:spawn th) (catch (e) 0)))
                            thunks)))
              (if (let scan ((xs ids))
                    (cond
                      ((not (pair? xs)) #f)
                      ((not (orchestrate:spawn-ok? (car xs))) #t)
                      (else (scan (cdr xs)))))
                (begin
                  (display "parallel=serial")
                  (newline)
                  (map (lambda (th) (th)) thunks))
                (begin
                  (display "parallel=fibers")
                  (newline)
                  (map (lambda (id)
                         (try (fiber:join id)
                              (catch (e) (list "error" "fiber" "join"))))
                       ids))))))))))

(define (orchestrate:show-trial contract evidence)
  (display "contract=")
  (display (string-join (map (lambda (p) (string-append (car p) "=" (cadr p)))
                             contract)
                        " "))
  (newline)
  (for-each
    (lambda (r)
      (display "apply=")
      (display (hash-ref r "task" ""))
      (display ":")
      (display (hash-ref r "path" ""))
      (display ":")
      (display (if (hash-ref r "ok" #f) "pass" "fail"))
      (newline))
    (trial:last-report))
  (display "test-summary=")
  (let ((t (text:lookup evidence "tests")))
    (display (if (string? t) t "missing")))
  (newline)
  (display "redgreen=")
  (let ((g (text:lookup evidence "redgreen")))
    (display (if (string? g) g "missing")))
  (newline)
  (let ((u (text:lookup evidence "test-unstable")))
    (if (string? u)
      (begin
        (display "test-unstable=")
        (display u)
        (newline))
      #f)))

(define (orchestrate:with-applied contract)
  (if (text:lookup contract "applied")
    contract
    (append contract (list (list "applied" "all")))))

;; KEEP needs a red-then-green test, a bench that was short before and
;; met after, or a performance speedup with equivalent output.
(define (orchestrate:with-redgreen contract evidence)
  (if (text:lookup contract "redgreen")
    contract
    (let ((got (text:lookup evidence "redgreen")))
      (append contract
              (list (list "redgreen"
                          (cond
                            ((equal? got "bench") "bench")
                            ((equal? got "speed") "speed")
                            (else "pass"))))))))

(define (orchestrate:rerun mode target context requirement feedback)
  (let loop ((specs *orchestrate-specs*) (acc '()))
    (if (not (pair? specs))
      (reverse acc)
      (let ((ev (worker:run (contract:worker-user target
                                                   (orchestrate:task-context context requirement (car specs))
                                                   requirement
                                                   (car specs) feedback)
                            mode)))
        (if (not (orchestrate:ok? ev))
          (orchestrate:note-error "retry" ev)
          #f)
        (loop (cdr specs) (if (orchestrate:ok? ev) (cons ev acc) acc))))))

(define (orchestrate:reject flags judge-s)
  (orchestrate:read-channel flags judge-s)
  (let ((tr (bus:trial judge-s 1)))
    (hash-set! flags "bus-trial" (orchestrate:flag tr))
    (if (orchestrate:ok? tr)
      (begin
        (hash-set! flags "bus-rollback" (orchestrate:flag (bus:rollback judge-s (cadr tr))))
        (hash-set! flags "result" "rollback"))
      #f))
  (hash-set! flags "bus-audit" (orchestrate:audit-flag judge-s)))

(define (orchestrate:deliver flags judge-s worker-ss contract tasks mode now ws requirement target context retries)
  (let ((ids (let loop ((xs tasks) (acc '()))
               (if (not (pair? xs))
                 (reverse acc)
                 (let ((posted (task:post-task judge-s (car xs))))
                   (if (orchestrate:ok? posted)
                     (loop (cdr xs) (cons (cadr posted) acc))
                     (loop (cdr xs) acc)))))))
    (hash-set! flags "task-backend" (task:backend))
    (hash-set! flags "tasks" (length ids))
    (let* ((first (orchestrate:run-workers worker-ss mode now target context requirement "" retries))
           (ready0 (and (= (length first) (length ids)) (pair? first)))
           (passed (let retry ((attempt 0)
                               (results first)
                               (evidence (if ready0
                                           (orchestrate:rebase-once
                                             mode target context requirement contract
                                             (trial:verdict ws requirement contract
                                                            (orchestrate:tag-changes first)))
                                           (begin (trial:clear!) '()))))
                     (begin
                       (orchestrate:show-trial contract evidence)
                       (if (or (not ready0)
                               (>= attempt retries)
                               (not (orchestrate:need-retry? evidence)))
                         (list results evidence)
                         (begin
                           (display "worker-retry=")
                           (display (+ attempt 1))
                           (newline)
                           (let* ((feedback (trial:last-log))
                                  (again (begin
                                           (orchestrate:feedback-summary feedback)
                                           (orchestrate:rerun mode target context requirement feedback)))
                                  (ready1 (and (= (length again) (length ids)) (pair? again)))
                                  (next (if ready1
                                          (trial:verdict ws requirement contract
                                                         (orchestrate:tag-changes again))
                                          evidence)))
                             (retry (+ attempt 1)
                                    (if ready1 again results)
                                    next)))))))
           (results (car passed))
           (evidence (cadr passed))
           (ready (and (= (length results) (length ids)) (pair? results))))
      (hash-set! flags "completed" (length results))
      (hash-set! flags "bus-publish"
                 (orchestrate:flag (bus:publish judge-s 1 (if ready 1 0))))
      (hash-set! flags "bus-subscribe" (orchestrate:flag (bus:subscribe judge-s 1)))
      (hash-set! flags "bus-query" (orchestrate:flag (bus:query judge-s 1 0 0)))
      (let ((tr (bus:trial judge-s 1)))
        (hash-set! flags "bus-trial" (orchestrate:flag tr))
        (if (orchestrate:ok? tr)
          (let ((d (judge:decide judge-s (cadr tr)
                                 (if ready
                                   (orchestrate:with-redgreen
                                     (orchestrate:with-applied contract)
                                     evidence)
                                   contract)
                                 (if ready evidence '())
                                 (hash "self-tests" (orchestrate:self-tests results)))))
            (hash-set! flags "gate-backend" (gate:backend))
            (if (orchestrate:ok? d)
              (let ((gate-record (car (cddr (cdr d)))))
                (hash-set! flags "result" (cadr d))
                (hash-set! flags "gate"
                           (if (equal? (cadr d) "keep")
                             "ok"
                             (if (and (pair? gate-record) (pair? (cdr gate-record)))
                               (cadr gate-record)
                               "fail")))
                (if (equal? (cadr d) "keep")
                  (hash-set! flags "bus-keep" (orchestrate:flag (caddr d)))
                  (hash-set! flags "bus-rollback" (orchestrate:flag (caddr d)))))
              (hash-set! flags "gate" "fail")))
          (hash-set! flags "gate" "fail"))
        (hash-set! flags "bus-audit" (orchestrate:audit-flag judge-s))))))

(define (orchestrate:plan-reason plan)
  (if (and (pair? plan) (pair? (cdr plan)) (pair? (cddr plan)) (string? (caddr plan)))
    (caddr plan)
    "plan"))

(define (orchestrate:note-dropped plan)
  (let ((dropped (if (and (pair? plan) (pair? (cdr plan)) (pair? (cddr plan))
                          (pair? (cdddr plan)) (list? (cadddr plan)))
                   (cadddr plan)
                   '())))
    (if (pair? dropped)
      (begin
        (display "contract-dropped=")
        (display (string-join dropped ","))
        (newline))
      #f)))

(define (orchestrate:pipeline flags planner-s judge-s worker-ss requirement mode approve-mode now graph ws target context retries)
  (let ((plan (planner:plan-with requirement mode graph target context)))
    (orchestrate:note-dropped plan)
    (if (not (orchestrate:ok? plan))
      (begin
        (hash-set! flags "llm-error" (orchestrate:plan-reason plan))
        (display "llm-error=")
        (display (hash-ref flags "llm-error"))
        (newline)
        (hash-set! flags "gate" "plan-fail"))
      (let ((contract (cadr plan))
            (tasks (caddr plan))
            (deadline (+ now 5)))
        (approve:open planner-s "contract" deadline)
        (hash-set! flags "approve-backend" (approve:backend))
        (cond
          ((equal? approve-mode "approved")
           (approve:decide planner-s "contract" "approved"))
          ((equal? approve-mode "denied")
           (approve:decide planner-s "contract" "denied"))
          (else #f))
        (let* ((when (if (equal? approve-mode "timeout") deadline now))
               (st (approve:status planner-s "contract" when))
               (decision (if (orchestrate:ok? st) (cadr st) "error")))
          (hash-set! flags "approve" decision)
          (if (equal? decision "approved")
            (orchestrate:deliver flags judge-s worker-ss contract tasks mode now
                                 ws requirement target context retries)
            (orchestrate:reject flags judge-s)))))))

(define (orchestrate:graph-on? cfg)
  (let ((v (hash-ref cfg "graph" #f))
        (env (getenv "AURA_AGENTS_GRAPH")))
    (if (or (equal? v #t) (equal? v "on") (equal? v "1")
            (equal? env "on") (equal? env "1"))
      #t
      #f)))

(define (orchestrate:latest-rollback g)
  (let loop ((xs (graph:nodes-by-type g "rollback-evidence")) (best #f))
    (cond
      ((not (pair? xs)) best)
      ((not (equal? (hash-ref (car xs) "status" "") "valid"))
       (loop (cdr xs) best))
      ((or (not best)
           (> (hash-ref (car xs) "seq" 0) (hash-ref best "seq" 0)))
       (loop (cdr xs) (car xs)))
      (else (loop (cdr xs) best)))))

(define (orchestrate:stamp events fp)
  (if (not (and (string? fp) (> (string-length fp) 0)))
    events
    (map (lambda (ev)
           (if (not (hash? ev))
             ev
             (let ((facts (let ((f (hash-ref ev "facts" (hash))))
                            (if (hash? f) f (hash)))))
               (hash-set! facts "req" fp)
               (hash-set! ev "facts" facts)
               ev)))
         events)))

(define (orchestrate:finalize-graph flags g on? fp)
  (if (not on?)
    (begin
      (hash-set! flags "graph" "off")
      (hash-set! flags "graph-nodes" 0)
      (hash-set! flags "graph-edges" 0))
    (begin
      (ingest:journal g (orchestrate:stamp (journal:events) fp))
      (if (equal? (hash-ref flags "result") "rollback")
        (let ((rb (orchestrate:latest-rollback g)))
          (if rb
            (invalidate:on-rollback! g (hash-ref rb "node_id")
                                     (+ (hash-ref rb "seq" 0) 1))
            #f))
        #f)
      (prune:run! g (hash "max-nodes" 256 "audit-window" 32))
      (graph:save! g)
      (hash-set! flags "graph" "on")
      (hash-set! flags "graph-nodes" (graph:node-count g))
      (hash-set! flags "graph-edges" (graph:edge-count g)))))

(define (orchestrate:contract-rollback? flags)
  (let ((g (hash-ref flags "gate" "")))
    (or (equal? g "contract-unsatisfied")
        (equal? g "empty-contract"))))

;; demo=ok is a finished attempt: at least one worker completed, and the
;; judge kept the trial or rolled it back because an executed check failed.
;; gate=incomplete means the contract was not fully run (a worker missing,
;; or a check the judge could not execute). That is not demo=ok.
(define (orchestrate:demo-ok? flags)
  (let ((n (hash-ref flags "completed" 0)))
    (and (equal? (hash-ref flags "bus-host") "ok")
         (equal? (hash-ref flags "bus-attach") "ok")
         (equal? (hash-ref flags "bus-unhost") "ok")
         (not (equal? (hash-ref flags "gate" "") "incomplete"))
         (number? n)
         (> n 0)
         (or (equal? (hash-ref flags "result") "keep")
             (and (equal? (hash-ref flags "result") "rollback")
                  (orchestrate:contract-rollback? flags))))))

(define (orchestrate:cleanup flags sessions ws)
  (for-each
    (lambda (s) (if (number? s) (bus:detach s) #f))
    sessions)
  (hash-set! flags "bus-unhost" (orchestrate:flag (bus:unhost ws)))
  (hash-set! flags "demo" (if (orchestrate:demo-ok? flags) "ok" "fail"))
  (orchestrate:emit flags)
  flags)

(define (orchestrate:retry-count cfg)
  (let ((n (hash-ref cfg "retries" #f)))
    (if (and (number? n) (>= n 0))
      n
      (let ((e (getenv "AURA_AGENTS_RETRIES")))
        (if (and (string? e) (number? (string->number e)) (>= (string->number e) 0))
          (if (integer? (string->number e))
            (string->number e)
            (inexact->exact (floor (string->number e))))
          2)))))

(define (orchestrate:hosted flags ws n requirement mode approve-mode now graph target context fp retries)
  (let* ((planner-a (bus:attach "" ws 0 127 31))
         (judge-a (bus:attach "" ws 0 127 31))
         (worker-ss (orchestrate:attach-workers ws n))
         (attached (and (orchestrate:ok? planner-a)
                        (orchestrate:ok? judge-a)
                        (= (length (filter number? worker-ss)) n))))
    (hash-set! flags "bus-attach" (if attached "ok" "fail"))
    (if (not attached)
      (orchestrate:cleanup flags (orchestrate:sessions planner-a judge-a worker-ss) ws)
      (begin
        (orchestrate:pipeline flags (cadr planner-a) (cadr judge-a) worker-ss
                              requirement mode approve-mode now graph
                              ws target context retries)
        (orchestrate:finalize-graph flags graph (if graph #t #f) fp)
        (orchestrate:cleanup flags (orchestrate:sessions planner-a judge-a worker-ss) ws)))))

(define (orchestrate:fresh-flags sample mode host)
  (let ((sized (supervisor:with-override (supervisor:size sample)
                                        (getenv "AURA_AGENTS_WORKERS"))))
    (hash "demo" "fail"
          "llm" mode
          "workers" (hash-ref sized "workers")
          "refused" (hash-ref sized "reason")
          "approve" "skipped"
          "tasks" 0
          "completed" 0
          "gate" "skipped"
          "result" "none"
          "bus-attach" "fail"
          "task-backend" "not-called"
          "approve-backend" "not-called"
          "gate-backend" "not-called"
          "graph" "off"
          "graph-nodes" 0
          "graph-edges" 0
          "bus-host" (orchestrate:flag host)
          "bus-publish" "skipped"
          "bus-subscribe" "skipped"
          "bus-query" "skipped"
          "bus-trial" "skipped"
          "bus-keep" "skipped"
          "bus-rollback" "skipped"
          "bus-audit" "skipped"
          "bus-unhost" "skipped")))

(define (orchestrate:run cfg)
  (task:reset!)
  (approve:reset!)
  (gate:reset!)
  (journal:reset!)
  (let* ((mode-given (hash-ref cfg "mode" #f))
         (mode (if (string? mode-given) mode-given (chat:mode)))
         (ws (let ((n (hash-ref cfg "workspace" 5398))) (if (number? n) n 5398)))
         (sample0 (hash-ref cfg "sample" #f))
         (sample (if (hash? sample0) sample0 (supervisor:read-sample)))
         (approve-mode (let ((a (hash-ref cfg "approve" "approved")))
                         (if (string? a) a "approved")))
         (now (let ((n (hash-ref cfg "now" 0))) (if (number? n) n 0)))
         (requirement (orchestrate:requirement cfg))
         (target (contract:target requirement (hash-ref cfg "target" #f)))
         (context (let ((given (hash-ref cfg "context" #f)))
                    (if (and (string? given) (> (string-length given) 0))
                      given
                      (let ((root (trial:root)))
                        (if root
                          (trial:external-context root requirement)
                          (trial:fixture-context (contract:kind requirement)))))))
         (fp (query:fingerprint target requirement))
         (graph-on (orchestrate:graph-on? cfg))
         (graph (if graph-on (graph:open ws) #f))
         (base (if graph
                 (+ 1 (max (hash-ref graph "last_ingested_seq" 0)
                           (hash-ref graph "seq" 0)))
                 1))
         (host (bus:host ws))
         (flags (orchestrate:fresh-flags sample mode host)))
    (journal:start-at! base)
    (if (not (orchestrate:ok? host))
      (begin (orchestrate:emit flags) flags)
      (orchestrate:hosted flags ws (hash-ref flags "workers")
                          requirement mode approve-mode now graph
                          target context fp
                          (orchestrate:retry-count cfg)))))
