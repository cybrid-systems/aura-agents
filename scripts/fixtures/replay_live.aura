;; Live #15 replay smoke: real TCP peers, run with exec granted.
(require "std/string")
(require "std/json")
(require "std/process")
(require "std/io")
(require "lib/replay/replay")

(define (line k v)
  (display k)
  (display "=")
  (display v)
  (newline))

(define (start-server script port pidfile)
  (shell (string-append "python3 " script " " (number->string port)
                        " >/tmp/replay-fixture.log 2>&1 & echo $! > " pidfile))
  (shell "sleep 0.5"))

(define (stop-server pidfile)
  (let ((pid (read-file pidfile)))
    (if (string? pid)
      (shell (string-append "kill " (string-trim pid)))
      #f)))

(start-server "tests/fixtures/redis_fixture.py" 6399 "/tmp/replay-redis.pid")
(define corpus (replay:redis-corpus 7 12 ""))
(define r1 (replay:redis-run "127.0.0.1" 6399 corpus))
(line "redis" (if (hash-ref r1 "ok" #f) "ok" "bad"))
(line "redis-count" (hash-ref r1 "count"))
(line "redis-errors" (hash-ref r1 "errors"))
(line "redis-corpus" (hash-ref r1 "corpus"))
(define hcorpus (replay:redis-corpus 7 9 "tok-abc"))
(define r2 (replay:redis-run "127.0.0.1" 6399 hcorpus))
(line "heldout-corpus" (hash-ref r2 "corpus"))
(stop-server "/tmp/replay-redis.pid")

(start-server "tests/fixtures/runner_fixture.py" 8799 "/tmp/replay-runner.pid")
(define rr (replay:runner-run "127.0.0.1" 8799 (hash "ticks" 20 "wish_at" 5)))
(line "runner" (if (hash-ref rr "ok" #f) "ok" "bad"))
(line "runner-ticks" (hash-ref rr "ticks"))
(line "runner-errors" (hash-ref rr "errors"))
(line "wish-positive" (if (and (number? (hash-ref rr "first_wish_ms"))
                               (>= (hash-ref rr "first_wish_ms") 0)) #t #f))
(line "p99-positive" (if (and (number? (hash-ref rr "tick_p99_ms"))
                              (>= (hash-ref rr "tick_p99_ms") 0)) #t #f))
(stop-server "/tmp/replay-runner.pid")
