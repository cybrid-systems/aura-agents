;; #15/#14 live acceptance: drive a real aura-redis and a real headless
;; aura-runner over their normal protocols, then take a real USE snapshot of
;; this host. Run through scripts/live-acceptance.sh; no target hooks.
(require "std/string")
(require "std/json")
(require "std/list")
(require "lib/replay/replay")
(require "lib/perf/observe")
(require "lib/troupe/troupe")

(define (line k v)
  (display k)
  (display "=")
  (display v)
  (newline))

(define (num h k d)
  (let ((v (hash-ref h k d)))
    (if (number? v) v d)))

(define (max-list xs)
  (let loop ((ys xs) (m 0))
    (cond ((not (pair? ys)) m)
          ((> (car ys) m) (loop (cdr ys) (car ys)))
          (else (loop (cdr ys) m)))))

(define redis-port (string->number (getenv "AURA_LIVE_REDIS_PORT")))
(define runner-port (string->number (getenv "AURA_LIVE_RUNNER_PORT")))

(define (env-num name fallback)
  (let ((raw (getenv name)))
    (let ((n (if (string? raw) (string->number raw) #f)))
      (if (and (number? n) (> n 0)) n fallback))))

(define redis-count (env-num "AURA_LIVE_REDIS_COMMANDS" 120))
(define redis-heldout-count (env-num "AURA_LIVE_REDIS_HELDOUT_COMMANDS" 90))

; ── real aura-redis: train and held-out corpora ─────────────────
(define train (replay:redis-run "127.0.0.1" redis-port
                                (replay:redis-corpus 7 redis-count "")))
(line "redis-train-ok" (hash-ref train "ok" #f))
(line "redis-train-errors" (hash-ref train "errors" -1))
(line "redis-train-corpus" (hash-ref train "corpus" "-"))
(line "redis-train-p99" (hash-ref train "p99_ms" -1))
(line "redis-train-json" (json-encode train))

(define held (replay:redis-run "127.0.0.1" redis-port
                               (replay:redis-corpus 7 redis-heldout-count "live-token")))
(line "redis-heldout-ok" (hash-ref held "ok" #f))
(line "redis-heldout-errors" (hash-ref held "errors" -1))
(line "redis-heldout-corpus" (hash-ref held "corpus" "-"))
(line "redis-heldout-p99" (hash-ref held "p99_ms" -1))
(line "redis-heldout-json" (json-encode held))

; ── real headless aura-runner: 120 ticks, four wishes ─────────
(define rr (replay:runner-run "127.0.0.1" runner-port
                              (hash "ticks" 120
                                    "wish_ats" (list 10 40 80 110))))
(line "runner-ok" (hash-ref rr "ok" #f))
(line "runner-ticks" (hash-ref rr "ticks" 0))
(line "runner-wishes" (hash-ref rr "wishes" 0))
(line "runner-first-wish-ms" (hash-ref rr "first_wish_ms" -1))
(line "runner-tick-p50-ms" (hash-ref rr "tick_p50_ms" -1))
(line "runner-tick-p99-ms" (hash-ref rr "tick_p99_ms" -1))
(line "runner-over-budget-pct" (hash-ref rr "over_budget_pct" -1))
(line "runner-errors" (hash-ref rr "errors" -1))
(line "runner-json" (json-encode rr))

; ── real external load for the #19 motif detector ──────────────
; Eight concurrent external clients; the server is not modified and has
; no probe. If the target stays healthy the detector must say no-motif.
(define fids
  (map (lambda (i)
         (fiber:spawn
           (lambda ()
             (replay:runner-run "127.0.0.1" runner-port
                                (hash "ticks" 240
                                      "wish_ats" (list 20 100 200)
                                      "seed" (+ 42 i))))))
       (list 1 2 3 4 5 6 7 8)))
(define load-runs (map (lambda (f) (fiber:join f)) fids))
(define load-p99 (max-list (map (lambda (r) (num r "tick_p99_ms" 0)) load-runs)))
(define load-wish (max-list (map (lambda (r) (num r "first_wish_ms" 0)) load-runs)))
(define load-over (max-list (map (lambda (r) (num r "over_budget_pct" 0)) load-runs)))
(line "load-clients" (length load-runs))
(line "load-ok" (length (filter (lambda (r) (hash-ref r "ok" #f)) load-runs)))
(line "load-p99" load-p99)
(line "load-wish" load-wish)
(line "load-over" load-over)

(define current (hash "tick_p99_ms" load-p99
                      "first_wish_ms" load-wish
                      "over_budget_pct" load-over))
(define motif (troupe:detect rr current))
(define scored (troupe:score motif))
(line "motif-severity" (hash-ref motif "severity" "none"))
(line "motif-signals" (json-encode (hash-ref motif "signals" '())))
(line "motif-probe-free" (hash-ref motif "probe_free" #f))
(line "motif-score-ok" (hash-ref scored "ok" #f))
(line "motif-json" (json-encode motif))

; ── real external-only USE snapshot (#14) ───────────────────────
(define probe (perf:probe))
(line "perf-mode" (hash-ref probe "mode" "-"))
(line "perf-degraded" (hash-ref probe "degraded" #t))
(line "perf-missing" (json-encode (hash-ref probe "missing" '())))
(line "perf-blocked" (json-encode (hash-ref probe "blocked" '())))
(line "perf-usable" (json-encode (hash-ref probe "usable" (hash))))
(define use (perf:report (hash "window_ms" 250)))
(line "perf-cpu-util" (hash-ref use "cpu_util_pct" -1))
(line "perf-ss" (json-encode (hash-ref use "ss" (hash))))
(line "perf-tcp" (json-encode (hash-ref use "tcp" (hash))))
(line "perf-hypotheses" (json-encode (hash-ref use "hypotheses" '())))
(line "perf-json" (json-encode use))
