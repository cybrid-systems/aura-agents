# Copy to .env (mode 0600). .env is gitignored. Never commit a key.
# The shell that launches Aura must export these; Aura reads the environment.
# Recommended real model: DeepSeek Flash. Put the key only in this file.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash

# mock (default, tests and CI) or real (calls llm:chat).
# Real mode must grant exec (the judge runs aura test) and network:
#   AURA_AGENTS_LLM=real aura run --grant exec,network
AURA_AGENTS_LLM=mock

# Optional. Unset sizes workers from CPU and memory. 0 is a failed demo.
# AURA_AGENTS_WORKERS=2

# Extra worker attempts after a failed test or an unparseable reply.
# AURA_AGENTS_RETRIES=2

# llm:chat transport budget, in seconds. Worker default 300, planner 150.
# A timeout is recorded as http-timeout and retried once.
# AURA_AGENTS_WORKER_TIMEOUT=300
# AURA_AGENTS_PLANNER_TIMEOUT=150
# AURA_AGENTS_LLM_TIMEOUT=
# AURA_AGENTS_TIMEOUT_RETRIES=1

# Cap planned tasks. Unset: 1, or 2 for the redis fixture.
# AURA_AGENTS_TASKS=1

# How many workers in one wave may call the model at once.
# Unset uses the worker pool size.
# AURA_AGENTS_PARALLEL=2

# Local Aura project to edit. Only out/trials/ is written.
# p99 and budget are added only when the requirement names them or bench.aura exists.
# AURA_AGENTS_TARGET=/path/to/project

# Bytes of external CONTEXT. Matching files are included in full first.
# AURA_AGENTS_CONTEXT_BUDGET=16384

# Speed KEEP: after ms= must be at most before/N. Default 2.
# AURA_AGENTS_SPEEDUP=2

# Demo approval on the stand-in for aura#5404: approved, denied, or timeout.
AURA_AGENTS_APPROVE=approved
