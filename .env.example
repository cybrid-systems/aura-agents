# Copy to .env (mode 0600). .env is gitignored. Never commit a key.
# The shell that launches Aura must export these; Aura reads the environment.
# Default model matches aura-runner: DeepSeek V4.1 Flash.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash

# mock (default, tests and CI) or real (calls llm:chat).
AURA_AGENTS_LLM=mock

# Demo approval on the stand-in for aura#5404: approved, denied, or timeout.
AURA_AGENTS_APPROVE=approved
