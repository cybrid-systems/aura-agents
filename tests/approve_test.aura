(require "std/bus")
(require "lib/adapt/approve")

(define (show label record)
  (display label)
  (display "=")
  (display (if (and (pair? record) (equal? (car record) "ok"))
             (if (pair? (cdr record)) (cadr record) "ok")
             (cadr record)))
  (newline))

(define ws 5912)
(bus:host ws)
(define session (cadr (bus:attach "" ws 0 127 31)))
(approve:reset!)

(show "open" (approve:open session "contract" 5))
(display "backend=")
(display (approve:backend))
(newline)
(show "pending" (approve:status session "contract" 0))
(show "decide" (approve:decide session "contract" "approved"))
(show "approved" (approve:status session "contract" 4))
(show "stays" (approve:status session "contract" 9))

(approve:reset!)
(approve:open session "contract" 5)
(show "deny" (approve:decide session "contract" "denied"))
(show "denied" (approve:status session "contract" 0))

(approve:reset!)
(approve:open session "contract" 5)
(show "timeout" (approve:status session "contract" 5))
(show "timeout-stays" (approve:status session "contract" 6))
(show "missing" (approve:status session "other" 0))

(display "unhost=")
(display (if (equal? (car (bus:unhost ws)) "ok") "ok" "fail"))
(newline)
