(require "std/bus")
(require "lib/graph/ingest")

(define bus-ws (+ 40000 (modulo (current-time) 10000)))
(define graph-ws 9191)
(bus:host bus-ws)
(define session (cadr (bus:attach "" bus-ws 0 255 63)))

(define posted (bus:post-task session 1 1 1))
(define task-id (cadr posted))
(bus:approve session task-id 0 1000)
(bus:approve session task-id 1 1000)
(define claimed (bus:claim session 100 task-id))
(define completed (bus:complete session task-id 1))

(display "post=") (display (car posted)) (newline)
(display "approve=") (display (car claimed)) (newline)
(display "complete=") (display (car completed)) (newline)

(graph:reset! graph-ws)
(define g (graph:new graph-ws))
(define r (ingest:from-bus g session task-id))
(display "ingest=") (display (car r)) (newline)
(display "nodes=") (display (graph:node-count g)) (newline)
(display "edges=") (display (graph:edge-count g)) (newline)
(display "approved=")
(display (if (pair? (filter (lambda (n) (equal? (hash-ref n "reason") "approval-approved"))
                            (graph:all-nodes g))) 1 0))
(newline)
(display "claimed=")
(display (if (pair? (filter (lambda (n) (equal? (hash-ref n "reason") "task-claimed"))
                            (graph:all-nodes g))) 1 0))
(newline)
(display "all-sourced=")
(display (let loop ((es (graph:all-edges g)))
           (cond ((not (pair? es)) 1)
                 ((> (hash-ref (car es) "event_seq" 0) 0) (loop (cdr es)))
                 (else 0))))
(newline)

(bus:detach session)
(display "unhost=") (display (car (bus:unhost bus-ws))) (newline)
(display "ok") (newline)
