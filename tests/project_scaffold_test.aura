;; Issue #22 — dry-run scaffold from the #21 spec: pinned #13 baseline,
;; branch protection, no tag/release, no network.
(require "std/string")
(require "std/io")
(require "std/json")
(require "lib/project/spec")
(require "lib/project/scaffold")

(define (line k v)
  (display k)
  (display "=")
  (display v)
  (newline))

(define baseline (json-parse (read-file "baseline/aura-baseline.json")))
(define sha (hash-ref (hash-ref baseline "aura") "commit_sha"))
(define x86 (hash-ref (hash-ref (hash-ref (hash-ref baseline "aura") "assets") "linux-x86_64") "sha256"))
(define arm (hash-ref (hash-ref (hash-ref (hash-ref baseline "aura") "assets") "linux-arm64") "sha256"))
(define digest (hash-ref (hash-ref baseline "aura_ci") "digest"))

(define spec (cadr (project:compile "用 aura 写一个坦克大战游戏")))
(define sc (project:scaffold spec))
(define toml (project:scaffold-file sc "aura.toml"))
(define ci (project:scaffold-file sc ".github/workflows/ci.yml"))
(define readme (project:scaffold-file sc "README.md"))

(line "repo" (hash-ref sc "repo"))
(line "visibility" (hash-ref sc "visibility"))
(line "files" (length (hash-ref sc "files" '())))
(line "copies" (length (hash-ref sc "copies" '())))
(line "branch-direct" (hash-ref (hash-ref sc "branch_protection") "direct_push"))
(line "branch-admin" (hash-ref (hash-ref sc "branch_protection") "admin_bypass"))
(line "toml-commit" (string-contains? toml sha))
(line "toml-x86" (string-contains? toml x86))
(line "toml-arm" (string-contains? toml arm))
(line "toml-digest" (string-contains? toml digest))
(line "ci-pinned" (string-contains? ci (string-append "aura-ci@" digest)))
(line "ci-test" (string-contains? ci "aura test"))
(line "readme" (string-prefix? readme (string-append "# " (hash-ref sc "repo"))))
(line "forbidden" (string-join (hash-ref sc "forbidden" '()) ","))
