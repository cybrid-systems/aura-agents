(require "std/bus")
(require "lib/adapt/task-board")

(define (show label record)
  (display label)
  (display "=")
  (display (if (and (pair? record) (equal? (car record) "ok")) "ok" (cadr record)))
  (newline))

(define ws 5911)
(define host (bus:host ws))
(define attached (bus:attach "" ws 0 127 31))
(define session (cadr attached))
(task:reset!)

(show "empty" (task:claim session "w1" 0))
(show "post" (task:post-task session "implement-zrangebyscore"))
(display "backend=")
(display (task:backend))
(newline)
(show "claim-w1" (task:claim session "w1" 0))
(show "claim-w2" (task:claim session "w2" 1))
(show "heartbeat-w2" (task:heartbeat session 1 "w2" 1))
(show "heartbeat-w1" (task:heartbeat session 1 "w1" 1))
(show "still-held" (task:claim session "w2" 2))
(show "reclaim" (task:claim session "w2" 3))
(show "old-heartbeat" (task:heartbeat session 1 "w1" 3))
(show "complete" (task:complete session 1 "w2" 3 "done"))
(show "complete-again" (task:complete session 1 "w2" 3 "done"))
(show "post-2" (task:post-task session "check-p99"))
(show "claim-fail" (task:claim session "w1" 0))
(show "fail" (task:fail session 2 "w1" 0 "gave-up"))
(show "no-reclaim-failed" (task:claim session "w2" 0))
(define bad-role (bus:attach "" ws 99 1 1))
(display "unknown-role=")
(display (if (and (pair? bad-role) (equal? (car bad-role) "error"))
           (cadr bad-role)
           "ok"))
(newline)
(define again (bus:attach "" ws 0 1 1))
(display "after-unknown-role=")
(display (if (and (pair? again) (equal? (car again) "ok")) "ok" "fail"))
(newline)
(if (and (pair? again) (equal? (car again) "ok")) (bus:detach (cadr again)) #f)
(display "unhost=")
(display (if (equal? (car (bus:unhost ws)) "ok") "ok" "fail"))
(newline)
(display "host=")
(display (if (equal? (car host) "ok") "ok" "fail"))
(newline)
