(require "std/string")
(require "std/fs")
(require "lib/llm/mock")
(require "lib/llm/chat")
(require "lib/roles/planner")
(require "lib/roles/worker")
(require "lib/roles/contract")
(require "lib/trial/workspace")
(require "lib/orchestrate")
(require "lib/text")

(define (line k v)
  (display k)
  (display "=")
  (display v)
  (newline))

(define (has path needle)
  (let ((s (read-file path)))
    (and (string? s) (string-contains? s needle))))

(line "prompts"
      (if (and (has "prompts/planner.txt" "CONTRACT")
               (has "prompts/worker.txt" "RESULT")
               (has "prompts/worker.txt" "self-report")
               (has "prompts/judge.txt" "gate")
               (has "demo/requirement.txt" "ZRANGEBYSCORE")
               (not (has "prompts/planner.txt" "aura-redis"))
               (not (has "prompts/worker.txt" "aura-redis")))
        "ok"
        "bad"))

(mock:reset!)
(define a (mock:complete "planner" "need"))
(define b (mock:complete "planner" "need"))
(line "mock-stable" (if (equal? a b) "ok" "bad"))
(line "mock-calls" (mock:calls))

(define plan (planner:parse a))
(line "plan" (if (equal? (car plan) "ok") "ok" "bad"))
(line "generic-tasks" (length (caddr plan)))
(line "generic-tests" (cadr (car (cadr plan))))
(line "generic-not-redis"
      (if (equal? (car (caddr plan)) "implement-change") "ok" "bad"))

(define worker (worker:parse (mock:complete "worker" "implement-zrangebyscore")))
(line "worker" (if (equal? (car worker) "ok") "ok" "bad"))
(line "worker-tests" (cadr (car (cadr worker))))

(define failed (worker:parse (mock:complete "worker" "SIMULATE-FAIL")))
(line "worker-fail" (cadr (car (cadr failed))))

(define planned (planner:plan "给 aura-redis 加 ZRANGEBYSCORE，p99 不退化。" "mock"))
(line "planner-plan" (if (equal? (car planned) "ok") "ok" "bad"))
(line "planner-tasks" (length (caddr planned)))
(line "planner-p99" (cadr (cadr (cadr planned))))
(line "planner-task" (car (caddr planned)))
(define ran (worker:run "implement-zrangebyscore" "mock"))
(line "worker-run" (if (equal? (car ran) "ok") "ok" "bad"))
(line "worker-change" (if (pair? (caddr ran)) "ok" "bad"))

(line "mode-default" (chat:mode-of #f #f))
(line "mode-key" (chat:mode-of #f #t))
(line "mode-mock" (chat:mode-of "mock" #t))
(line "mode-real" (chat:mode-of "real" #f))
(line "model-default" (chat:model-of #f))
(line "model-env" (chat:model-of "custom-model"))

(define invented (planner:parse "CONTRACT tests=pass aura_cli=ok wordcount=ok wc:count(\"\")=0\nTASK implement-word-count\n"))
(line "invented" (car invented))
(line "invented-n" (length (cadr invented)))
(line "invented-tests" (cadr (car (cadr invented))))
(line "invented-drop" (string-join (cadddr invented) ","))

(define only-bad (planner:parse "CONTRACT aura_cli=ok wordcount=ok\nTASK x\n"))
(line "only-bad" (car only-bad))
(line "only-bad-reason" (if (string-prefix? (caddr only-bad) "dropped ") "ok" "bad"))

(define ctx (trial:fixture-context "wordcount"))
(line "ctx-src" (if (string-contains? ctx "(define (wc:count text) 0)") "ok" "bad"))
(line "ctx-none" (if (string=? ctx "none") "bad" "ok"))
(line "ctx-cap" (if (<= (string-length ctx) 4200) "ok" "bad"))

(define noisy (contract:planner-user "local/wordcount"
                 (string-append ctx "\nbudget=ok p99=regressed zrangebyscore\n")
                 "写一个单词计数命令行" ""))
(define noisy-plan (planner:parse (contract:reply noisy)))
(line "noisy-checks" (string-join (map (lambda (p) (car p)) (cadr noisy-plan)) ","))

(define block (worker:parse (string-append
  "RESULT tests=pass\n"
  "MUTATE src/marker.aura\n"
  "OLD\n"
  "(define (marker:done?)\n"
  "  #f)\n"
  "END OLD\n"
  "NEW\n"
  "(define (marker:done?)\n"
  "  #t)\n"
  "END NEW\n")))
(define ch (car (caddr block)))
(line "block-old" (if (string-contains? (hash-ref ch "old") "\n") "ok" "bad"))
(line "block-new" (if (string-contains? (hash-ref ch "new") "#t") "ok" "bad"))
(define dest (trial:dest 9420 "generic"))
(trial:isolate "generic" dest)
(file-write (string-append dest "/src/marker.aura") "(define (marker:done?)\n  #f)\n")
(line "block-apply" (if (trial:apply-one dest ch) "ok" "bad"))
(line "block-exec" (text:lookup (trial:observe dest '(("tests" "pass"))) "tests"))

(line "incomplete-demo"
      (if (orchestrate:demo-ok? (hash "bus-host" "ok" "bus-attach" "ok" "bus-unhost" "ok"
                                      "completed" 2 "result" "rollback" "gate" "incomplete"))
        "ok" "fail"))
(line "unsatisfied-demo"
      (if (orchestrate:demo-ok? (hash "bus-host" "ok" "bus-attach" "ok" "bus-unhost" "ok"
                                      "completed" 2 "result" "rollback" "gate" "contract-unsatisfied"))
        "ok" "fail"))
