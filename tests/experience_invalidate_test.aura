(require "lib/graph/invalidate")
(require "lib/graph/query")

(define ws 9130)
(graph:reset! ws)
(define g (graph:new ws))

(define (node tag wl seq)
  (let ((made (graph:make-node
                (hash "type" "keep-evidence" "workspace_id" ws "worldline" wl
                      "candidate_hash" (string-append "c" (number->string seq))
                      "caps_mask" 1 "budget_snapshot" (hash)
                      "seq" seq "timestamp_ms" seq
                      "summary" tag "tags" (list tag)))))
    (graph:add-node! g (cadr made))
    (hash-ref (cadr made) "node_id")))

(define (edge type from to seq)
  (let ((made (graph:make-edge
                (hash "type" type "from" from "to" to "workspace_id" ws
                      "worldline" 1 "event_seq" seq "task_id" 0))))
    (graph:add-edge! g (cadr made))))

(define a (node "chain-a" 1 1))
(define b (node "chain-b" 1 2))
(define c (node "chain-c" 1 3))
(define d (node "other-d" 2 4))
(edge "depends-on" b a 10)
(edge "depends-on" c b 11)

(define r1 (invalidate:downstream! g a 20 "rollback"))
(display "first=") (display (car r1)) (newline)
(display "first-count=") (display (cadr r1)) (newline)
(display "invalid=") (display (length (graph:invalid-nodes g))) (newline)
(display "d-valid=") (display (hash-ref (graph:get-node g d) "status")) (newline)
(display "a-valid=") (display (hash-ref (graph:get-node g a) "status")) (newline)
(display "a-from=") (display (hash-ref (graph:get-node g a) "invalid_from_seq")) (newline)

(define q (graph:query-for-planner g (list "chain-a" "chain-b" "chain-c") (hash "max-hops" 3)))
(display "hint-has-chain=") (display (if (string-contains? (hash-ref q "hint") "chain-") 1 0)) (newline)

(define e (node "multi-e" 1 5))
(define f (node "multi-f" 1 6))
(edge "depends-on" e a 12)
(edge "depends-on" e f 13)
(invalidate:downstream! g a 21 "rollback")
(display "multi-invalid=") (display (hash-ref (graph:get-node g e) "status")) (newline)
(display "multi-valid=") (display (hash-ref (graph:get-node g f) "status")) (newline)

(define cyc1 (node "cycle-1" 3 7))
(define cyc2 (node "cycle-2" 3 8))
(edge "depends-on" cyc1 cyc2 14)
(edge "depends-on" cyc2 cyc1 15)
(display "cycle=") (display (car (invalidate:downstream! g cyc1 22 "cycle"))) (newline)
(display "cycle-invalid=") (display (length (filter (lambda (n)
                                                       (or (equal? (hash-ref n "summary") "cycle-1")
                                                           (equal? (hash-ref n "summary") "cycle-2")))
                                                     (graph:invalid-nodes g)))) (newline)

(define rb (node "rollback-node" 1 9))
(display "repeat=") (display (cadr (invalidate:downstream! g a 23 "rollback" rb))) (newline)
(display "overturned=")
(display (length (filter (lambda (edge) (equal? (hash-ref edge "type") "overturned-by"))
                         (graph:all-edges g))))
(newline)

(display "save=") (display (car (graph:save! g))) (newline)
(define reloaded (graph:load ws))
(display "reload-invalid=") (display (length (graph:invalid-nodes reloaded))) (newline)
(display "reload-total=") (display (graph:node-count reloaded)) (newline)
(display "ok") (newline)
