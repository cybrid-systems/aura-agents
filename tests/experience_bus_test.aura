(require "std/bus")
(require "lib/graph/ingest")

(define bus-ws (+ 20000 (modulo (current-time) 10000)))
(define graph-ws 9181)
(bus:host bus-ws)
(define session (cadr (bus:attach "" bus-ws 0 255 63)))

(define posted (bus:post-task session 1 1 0))
(define claimed (bus:claim session 100 0))
(define task-id (cadr claimed))
(define completed (bus:complete session task-id 1))

(display "post=") (display (car posted)) (newline)
(display "claim=") (display (car claimed)) (newline)
(display "complete=") (display (car completed)) (newline)

(graph:reset! graph-ws)
(define g (graph:new graph-ws))
(define r (ingest:from-bus g session task-id))
(display "ingest=") (display (car r)) (newline)
(display "nodes=") (display (graph:node-count g)) (newline)
(display "edges=") (display (graph:edge-count g)) (newline)
(display "posted=")
(display (if (pair? (filter (lambda (n) (equal? (hash-ref n "reason") "task-posted"))
                            (graph:all-nodes g))) 1 0))
(newline)
(display "completed=")
(display (if (pair? (filter (lambda (n) (equal? (hash-ref n "reason") "task-completed"))
                            (graph:all-nodes g))) 1 0))
(newline)
(display "worldline=")
(display (let ((n (car (filter (lambda (n) (equal? (hash-ref n "reason") "task-completed"))
                               (graph:all-nodes g)))))
           (if (= (hash-ref n "worldline") task-id) "task" "other")))
(newline)

(bus:detach session)
(display "unhost=") (display (car (bus:unhost bus-ws))) (newline)
(display "ok") (newline)
