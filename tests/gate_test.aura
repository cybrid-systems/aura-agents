(require "std/bus")
(require "lib/adapt/gate")
(require "lib/roles/judge")

(define (show label record)
  (display label)
  (display "=")
  (display (if (and (pair? record) (equal? (car record) "ok"))
             (if (and (pair? (cdr record)) (string? (cadr record))) (cadr record) "ok")
             (cadr record)))
  (newline))

(define ws 5913)
(bus:host ws)
(define session (cadr (bus:attach "" ws 0 127 31)))
(gate:reset!)

(define contract '(("tests" "pass") ("p99" "ok")))
(show "empty" (gate:evidence session '() '(("tests" "pass"))))
(show "pass" (gate:evidence session contract contract))
(display "backend=")
(display (gate:backend))
(newline)
(show "regressed" (gate:evidence session contract '(("tests" "pass") ("p99" "regressed"))))
(show "incomplete" (gate:evidence session contract '(("tests" "pass"))))

(define trial (bus:trial session 1))
(define kept (judge:decide session (cadr trial) contract contract))
(show "judge" kept)
(show "keep" (caddr kept))

(define trial2 (bus:trial session 1))
(define rolled (judge:decide session (cadr trial2) contract '(("tests" "fail") ("p99" "ok"))))
(show "judge-rollback" rolled)
(show "rollback" (caddr rolled))

(display "unhost=")
(display (if (equal? (car (bus:unhost ws)) "ok") "ok" "fail"))
(newline)
