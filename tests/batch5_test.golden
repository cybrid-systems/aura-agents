multi-n=2
multi-a=src/a.aura:pass:h1
multi-b=src/b.aura:pass:h1
multi-a-body=(define (a:v) 1)
multi-b-body=(define (b:v) 2)
new-file=src/c.aura:pass:h1
new-body=(define (c:v) 3)
escape-n=2
escape-0=../../outside.aura:fail:h1
escape-1=/tmp/b5-abs.aura:fail:h1
escape-body=(define (a:v) 1)
escape-outside=refused
escape-abs=refused
miss-row=src/b.aura:fail:h1
miss-log=file-hunk
constant-tests=fail
constant-redgreen=still-red
constant-why=said
already-tests=pass
already-redgreen=not-red
already-why=said
notred-tests=pass
notred-redgreen=not-red
fixed-tests=pass
fixed-redgreen=pass
fixed-applied=all
ext-p99=no
ext-budget=no
ext-named-p99=ok
nobench-p99=no-bench
nobench-why=said
budget-default=4096
budget-set=32
ctx-full=ok
ctx-body=ok
ctx-list=ok
ctx-abs=rel
ctx-clip=24
planner-timeout=http-timeout
planner-retriable=yes
parse-class=parse
parse-detail=no RESULT
worker-error=word reason=http-timeout detail=http-post: timeout
worker-retry=1
feedback-summary=previous reply was not a RESULT plus PATCH or MUTATE
timeout-retry=ok
