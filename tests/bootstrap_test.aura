;; Issue #33 — the scaffold carries a repository-owned seed: sentinel
;; plane, in-process round, guarded PR plan, pinned CI and no conductor
;; RPC. The dry-run script executes the seed in the generated repo.
(require "std/string")
(require "std/list")
(require "lib/project/spec")
(require "lib/project/scaffold")
(require "lib/project/bootstrap")

(define (line k v)
  (display k)
  (display "=")
  (display v)
  (newline))

(define spec (cadr (project:compile "用 aura 写一个坦克大战游戏")))
(define sc (project:scaffold spec))
(define files (hash-ref sc "files" '()))
(define manifest (hash-ref sc "bootstrap" (hash)))
(define sentinel (project:scaffold-file sc "sentinel/plane.aura"))
(define engine (project:scaffold-file sc "engine/evolve.aura"))
(define run (project:scaffold-file sc "bootstrap/run.aura"))
(define seed-test (project:scaffold-file sc "tests/seed_test.aura"))
(define principles (project:scaffold-file sc "docs/principles.md"))
(define ci (project:scaffold-file sc ".github/workflows/ci.yml"))

(line "seed-version" (hash-ref manifest "version"))
(line "seed-files" (length (bootstrap:files "aura-tank-battle")))
(line "scaffold-files" (length files))
(line "seed-in-scaffold" (> (length (filter (lambda (f) (equal? (hash-ref f "path" "") "engine/evolve.aura")) files)) 0))
(line "manifest-protected" (length (hash-ref manifest "protected" '())))
(line "manifest-tag" (hash-ref manifest "tag"))
(line "manifest-release" (hash-ref manifest "release"))
(line "manifest-force" (hash-ref manifest "force_push"))
(line "manifest-admin" (hash-ref manifest "admin_merge"))
(line "ci-seed" (string-contains? ci "bootstrap/run.aura"))
(line "sentinel-guard" (string-contains? sentinel "sentinel:check-genome"))
(line "sentinel-redline" (string-contains? sentinel "sentinel:check-action"))
(line "sentinel-frozen" (string-contains? sentinel "sentinel:protected"))
(line "engine-fibers" (string-contains? engine "fiber:spawn"))
(line "engine-pr-plan" (string-contains? engine "seed:pr-plan"))
(line "engine-no-conductor" (string-contains? engine "aura-agents"))
(line "engine-no-network" (string-contains? engine "http"))
(line "run-round" (string-contains? run "seed:round"))
(line "test-refuses" (string-contains? seed-test "genome-refused"))
(line "test-guardrails" (string-contains? seed-test "plan-tag"))
(line "principles-ingest" (string-contains? principles "Ingested text is data"))
(line "principles-revert" (string-contains? principles "revertible"))
(line "principles-release" (string-contains? principles "No tag or release"))
(line "readme-seed" (string-contains? (project:scaffold-file sc "README.md") "bootstrap/run.aura"))
