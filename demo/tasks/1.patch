+/* Redis score bound: an optional leading '(' means the bound is exclusive.
+   -inf/+inf are accepted by parse_double. */
+static int parse_score_bound(const char* p, size_t n, double* out,
+                             int* exclusive) {
+  *exclusive = 0;
+  if (n > 0 && p[0] == '(') {
+    *exclusive = 1;
+    p++;
+    n--;
+  }
+  return parse_double(p, n, out);
+}
